---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
const postsZh = posts.filter((post) => post.data.lang === 'zh');
const postsEn = posts.filter((post) => post.data.lang === 'en');
---

<PageLayout
  title="Blog"
  description="Essays, field notes, and longer reads by Tung Wang."
  pageTitle="Tung’s Blog"
  pageClass="blog-page"
  lang="zh-CN"
  activeSection="blog"
  contentCard
  headerLanguage="blog"
>
  <div class="blog-index" data-blog-language-scope data-blog-language="zh">
    <section data-blog-language-panel="zh" aria-label="中文文章">
      <div class="post-list" data-masonry-grid>
        {postsZh.map((post) => <BlogPostCard post={post} />)}
      </div>
    </section>
    <section data-blog-language-panel="en" aria-label="English posts">
      <div class="post-list" data-masonry-grid>
        {postsEn.map((post) => <BlogPostCard post={post} />)}
      </div>
    </section>
  </div>
  <div slot="after-main" class="masonry-boundary-mask masonry-boundary-mask--top" aria-hidden="true">
    <i class="masonry-boundary-mask__corner masonry-boundary-mask__corner--left-card"></i>
    <i class="masonry-boundary-mask__corner masonry-boundary-mask__corner--right-card"></i>
  </div>
  <div slot="after-main" class="masonry-boundary-mask masonry-boundary-mask--bottom" aria-hidden="true">
    <i class="masonry-boundary-mask__corner masonry-boundary-mask__corner--left-card"></i>
    <i class="masonry-boundary-mask__corner masonry-boundary-mask__corner--right-card"></i>
  </div>
</PageLayout>

<script>
  import '../../scripts/masonry-grid';
  import '../../scripts/masonry-boundary-clips';
</script>

<style lang="scss" is:global>
  @use '../../styles/partials/blog';
</style>
