---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import BlogTableOfContents from '../../components/BlogTableOfContents.astro';
import Bibliography from '../../components/blog/Bibliography.astro';
import BlogFigure from '../../components/blog/BlogFigure.astro';
import BlogGallery from '../../components/blog/BlogGallery.astro';
import Callout from '../../components/blog/Callout.astro';
import Citation from '../../components/blog/Citation.astro';
import ImageCompare from '../../components/blog/ImageCompare.astro';
import PullQuote from '../../components/blog/PullQuote.astro';
import Sidenote from '../../components/blog/Sidenote.astro';
import VideoBlock from '../../components/blog/VideoBlock.astro';
import { calculateReadingTime } from '../../utils/reading-time';
import { formatSiteDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = (
    await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)
  ).sort((a, b) => +b.data.date - +a.data.date);

  return posts.map((post) => {
    const languagePosts = posts.filter((candidate) => candidate.data.lang === post.data.lang);
    const index = languagePosts.findIndex((candidate) => candidate.id === post.id);
    const translation = post.data.translationKey
      ? posts.find(
          (candidate) =>
            candidate.data.translationKey === post.data.translationKey &&
            candidate.data.lang !== post.data.lang,
        )
      : undefined;

    return {
      params: { slug: post.id },
      props: {
        post,
        prev: languagePosts[index + 1],
        next: languagePosts[index - 1],
        translation,
      },
    };
  });
}

const { post, prev, next, translation } = Astro.props;
const { Content, headings } = await render(post);
const mdxComponents = {
  Bibliography,
  BlogFigure,
  BlogGallery,
  Callout,
  Citation,
  ImageCompare,
  PullQuote,
  Sidenote,
  VideoBlock,
};
const hasTableOfContents =
  headings.filter(
    (heading) => heading.depth >= 1 && heading.depth <= 3 && heading.text.trim().length > 0,
  ).length >= 3;
const isEnglish = post.data.lang === 'en';
const readTime = calculateReadingTime(post.body);
const zhHref =
  isEnglish && translation
    ? `/blog/${translation.id}`
    : !isEnglish
      ? `/blog/${post.id}`
      : undefined;
const enHref =
  !isEnglish && translation
    ? `/blog/${translation.id}`
    : isEnglish
      ? `/blog/${post.id}`
      : undefined;
const alternateLanguages = translation
  ? [
      {
        lang: 'zh-CN',
        href: `/blog/${isEnglish ? translation.id : post.id}`,
      },
      {
        lang: 'en',
        href: `/blog/${isEnglish ? post.id : translation.id}`,
      },
      {
        lang: 'x-default',
        href: `/blog/${isEnglish ? translation.id : post.id}`,
      },
    ]
  : undefined;
---

<PageLayout
  title={post.data.title}
  description={post.data.excerpt}
  heroImage={post.data.cover}
  pageTitle={`${post.data.title} - Tung’s Blog`}
  pageClass={`blog-page blog-post-page${hasTableOfContents ? ' has-blog-toc' : ''}`}
  lang={isEnglish ? 'en' : 'zh-CN'}
  blogHref={isEnglish ? '/blog?lang=en' : '/blog'}
  headerLanguage={post.data.translationKey ? 'blog' : undefined}
  languageCurrent={post.data.lang}
  languageZhHref={zhHref}
  languageEnHref={enHref}
  alternateLanguages={alternateLanguages}
>
  <BlogTableOfContents
    slot="after-nav"
    headings={headings}
    lang={post.data.lang}
    variant="mobile"
  />
  <div class="post-meta">
    <span>{post.data.author}</span>
    <span>{formatSiteDate(post.data.date)}</span>
    <span>{readTime}</span>
  </div>

  <div class="blog-post-layout">
    <BlogTableOfContents headings={headings} lang={post.data.lang} variant="desktop" />
    <div class="prose" data-lightbox-scope>
      <Content components={mdxComponents} />
    </div>
  </div>

  <nav
    slot="after-main"
    class="post-nav post-nav--paper-external"
    aria-label={isEnglish ? 'Adjacent essays' : '相邻文章'}
  >
    {
      prev ? (
        <a class="post-nav__prev" href={`/blog/${prev.id}`}>
          <span>{isEnglish ? '← Previous' : '← 上一篇'}</span>
          <strong>{prev.data.title}</strong>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="post-nav__next" href={`/blog/${next.id}`}>
          <span>{isEnglish ? 'Next →' : '下一篇 →'}</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</PageLayout>

<style lang="scss" is:global>
  @use '../../styles/partials/microblog';
  @use '../../styles/partials/blog';
  @use '../../styles/partials/youtube';
  @use '../../styles/partials/editorial-elements';
  @use '../../styles/partials/blog-paper';
</style>

<script>
  const initialiseMobileBlogNavigation = () => {
    const page = document.querySelector<HTMLElement>('.blog-post-page');
    if (!page || page.dataset.mobileNavAutoHideReady === 'true') return;
    page.dataset.mobileNavAutoHideReady = 'true';

    const mobileQuery = window.matchMedia('(max-width: 768px)');
    let previousY = Math.max(0, window.scrollY);
    let frame = 0;

    const setHidden = (hidden: boolean) => {
      document.body.classList.toggle('blog-mobile-nav-hidden', hidden);
      document.documentElement.classList.toggle('blog-mobile-nav-hidden', hidden);
    };
    const reveal = () => setHidden(false);

    const update = () => {
      frame = 0;
      const currentY = Math.max(0, window.scrollY);
      const delta = currentY - previousY;

      if (!mobileQuery.matches || document.body.classList.contains('menu-open') || currentY <= 72) {
        reveal();
      } else if (delta > 5) {
        setHidden(true);
      } else if (delta < -5) {
        reveal();
      }

      previousY = currentY;
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    mobileQuery.addEventListener('change', () => {
      previousY = Math.max(0, window.scrollY);
      reveal();
    });
    document.querySelector('[data-menu-toggle]')?.addEventListener('click', reveal);
  };

  initialiseMobileBlogNavigation();
  document.addEventListener('astro:page-load', initialiseMobileBlogNavigation);
</script>
