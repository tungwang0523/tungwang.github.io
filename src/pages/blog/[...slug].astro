---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import BlogLanguageToggle from '../../components/BlogLanguageToggle.astro';
import BlogTableOfContents from '../../components/BlogTableOfContents.astro';
import { calculateReadingTime } from '../../utils/reading-time';
import { formatSiteDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => +b.data.date - +a.data.date,
  );

  return posts.map((post) => {
    const languagePosts = posts.filter((candidate) => candidate.data.lang === post.data.lang);
    const index = languagePosts.findIndex((candidate) => candidate.id === post.id);
    const translation = post.data.translationKey
      ? posts.find(
          (candidate) =>
            candidate.data.translationKey === post.data.translationKey &&
            candidate.data.lang !== post.data.lang,
        )
      : undefined;

    return {
      params: { slug: post.id },
      props: {
        post,
        prev: languagePosts[index + 1],
        next: languagePosts[index - 1],
        translation,
      },
    };
  });
}

const { post, prev, next, translation } = Astro.props;
const { Content, headings } = await render(post);
const hasTableOfContents = headings.filter(
  (heading) => heading.depth >= 1 && heading.depth <= 3 && heading.text.trim().length > 0,
).length >= 3;
const isEnglish = post.data.lang === 'en';
const readTime = calculateReadingTime(post.body);
const zhHref = isEnglish && translation ? `/blog/${translation.id}` : !isEnglish ? `/blog/${post.id}` : undefined;
const enHref = !isEnglish && translation ? `/blog/${translation.id}` : isEnglish ? `/blog/${post.id}` : undefined;

---

<PageLayout
  title={post.data.bigTitle}
  description={post.data.excerpt}
  eyebrow={post.data.pageNumber ?? 'Essay'}
  heroImage={post.data.cover}
  pageTitle={`${post.data.title} - Tung‘s Blog`}
  pageClass={`blog-page blog-post-page${hasTableOfContents ? ' has-blog-toc' : ''}`}
  lang={isEnglish ? 'en' : 'zh-CN'}
  blogHref={isEnglish ? '/blog?lang=en' : '/blog'}
>
  {
    post.data.translationKey && (
      <div class="blog-post-language">
        <BlogLanguageToggle current={post.data.lang} zhHref={zhHref} enHref={enHref} />
      </div>
    )
  }
  <div class="post-meta">
    <span>{post.data.author}</span>
    <span>{formatSiteDate(post.data.date)}</span>
    <span>{readTime}</span>
  </div>

  {
    post.data.tags.length > 0 && (
      <div class="tag-list" style="margin-top: 24px;">
        {post.data.tags.map((tag) => (
          <a href={`/tags/${tag}`}>{tag}</a>
        ))}
      </div>
    )
  }

  <hr class="post-intro-divider" />

  <div class="blog-post-layout">
    <BlogTableOfContents headings={headings} lang={post.data.lang} />
    <div class="prose" data-lightbox-scope>
      <Content />
    </div>
  </div>

  <nav class="post-nav" aria-label={isEnglish ? 'Adjacent essays' : '相邻文章'}>
    {
      prev ? (
        <a class="post-nav__prev" href={`/blog/${prev.id}`}>
          <span>{isEnglish ? '← Previous' : '← 上一篇'}</span>
          <strong>{prev.data.bigTitle}</strong>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="post-nav__next" href={`/blog/${next.id}`}>
          <span>{isEnglish ? 'Next →' : '下一篇 →'}</span>
          <strong>{next.data.bigTitle}</strong>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</PageLayout>
