    status: 'Under review at',
    venue: 'International Journal of Human–Computer Interaction',
    note: 'Preprint available on SSRN.',
    href: 'https://doi.org/10.2139/ssrn.7201181',
    linkLabel: 'doi:10.2139/ssrn.7201181',
  },
  {
    before: 'F. You, X. Yan, ',
    author: 'Z. Wang',
    after: ', & Q. Fu (2026).',
    title:
      'Seeing the whole process: How cooperative process transparency in AR-HMI affects driver cognition in V2V lane changes.',
