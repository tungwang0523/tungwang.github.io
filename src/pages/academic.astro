---
import PageLayout from '../layouts/PageLayout.astro';

const publications = [
  {
    before: '',
    author: 'Z. Wang',
    after: ', & F. You (2026).',
    title:
      'From Subtle Embodied Social Experience to Designable Relations: An Image-Schema-Mediated Empirical-to-Design Method',
    credit: 'First author',
    status: 'Under review at',
    venue: 'ACM CHI 2027',
    note: 'Preprint available on SSRN.',
    href: 'https://doi.org/10.2139/ssrn.7201181',
    linkLabel: 'doi:10.2139/ssrn.7201181',
  },
  {
    before: 'F. You, X. Yan, ',
    author: 'Z. Wang',
    after: ', & Q. Fu (2026).',
    title:
      'Seeing the whole process: How cooperative process transparency in AR-HMI affects driver cognition in V2V lane changes.',
    credit: 'Corresponding author',
    venue: 'Transportation Research Part F: Traffic Psychology and Behaviour, 123, 103830.',
    href: 'https://doi.org/10.1016/j.trf.2026.103830',
    linkLabel: 'doi:10.1016/j.trf.2026.103830',
  },
  {
    before: 'Y. Chen, F. Jia, ',
    author: 'Z. Wang',
    after: ', J. Zhang, F. You, & J. Wang (2026).',
    title:
      'Designing multimodal takeover request interfaces: The impact of warning modalities and information types on drivers’ takeover performance and subjective perception.',
    credit: 'Co-author',
    status: 'Under review at',
    venue: 'Transportation Research Part F: Traffic Psychology and Behaviour',
  },
  {
    before: 'Y. Chen, Y. Jin, F. Jia, J. Wang, ',
    author: 'Z. Wang',
    after: ', B. Mehler, & F. You (2026).',
    title:
      'Beyond attention reminders: Effects of monitoring request design type and non-driving-related task engagement on driver takeover performance and subjective perceptions.',
    credit: 'Co-author',
    status: 'Under review at',
    venue: 'Accident Analysis & Prevention',
  },
  {
    before: 'Y. Chen, J. Wang, F. Jia, X. Wu, Q. Xiao, ',
    author: 'Z. Wang',
    after: ', & F. You (2025).',
    title:
      'Is control necessary for drivers? Exploring the influence of human–machine collaboration modes on driving behavior and subjective perception under different hazard visibility scenarios.',
    credit: 'Co-author',
    venue: 'Accident Analysis & Prevention, 217, 108067.',
    href: 'https://doi.org/10.1016/j.aap.2025.108067',
    linkLabel: 'doi:10.1016/j.aap.2025.108067',
  },
];

const education = [
  {
    period: '9/2024 - 6/2027',
    degree: 'M.A. in Design',
    institutions: [
      { label: 'Tongji University, Shanghai, China', href: 'https://www.tongji.edu.cn/' },
    ],
    details: [
      'Working thesis title: Mixed-Reality Interaction Design for Public-Space Social Experience',
      'GPA: 4.76/5.0 · Supervisor: Professor Fang You, FRSA',
      'Selected coursework: User Research 98/100; Narrative Studies 90/100; Service Design 96/100.',
    ],
  },
  {
    period: '9/2020 - 6/2024',
    degree: 'B.Sc. in Physics',
    institutions: [
      { label: 'Jilin University, Changchun, China', href: 'https://www.jlu.edu.cn/' },
    ],
    details: ['Selected coursework: Computational Physics A 96/100; Mechanics 93/100; C Programming 92/100.'],
  },
];

const projects = [
  {
    period: '2025 - Present',
    title: 'XR Design for Subtle Embodied Social Experience',
    role: 'Master’s Thesis Researcher, Tongji University',
    description: '',
    bullets: [
      'Social and design proposition: Used gaze as a case of subtle embodied experience to reimagine relations among strangers in public space, proposing XR imagery as an interaction mediator and discursive medium for alternative forms of public sociality.',
      'Experiential modelling: To determine what such imagery should represent, used conceptual metaphor and image-schema theories to model how gaze enters experience, acquires embodied/metaphorical meaning and informs action; distinguished substrate-level from meaning-construal affordances.',
      'First-person inquiry: To ground this model in lived experience, combined episode-focused first-person inquiry with a dual-track analysis of fleeting gaze episodes, separating problem-defining perceptual conditions from relation-providing conceptual-metaphorical relations.',
      'Empirical-to-design translation: To make open-ended experiential material operable in design, developed an image-schema-mediated method structuring it as a constrained relational design space, preserving empirical grounding while allowing designer judgment and multiple defensible forms.',
      'Design case and implementation: Applied the process with 16 participants (782 interview minutes; 160,162 Chinese transcript characters), deriving a relational grammar and three XR concepts; selected Membrane–Bubble and currently implementing it in Unity XR for laboratory evaluation.',
    ],
  },
  {
    period: '2025 - Present',
    title: 'Cooperative Process Transparency in AR-HMI',
    role: 'Co-Researcher, Tongji University',
    description:
      'Examines how different levels of cooperative process transparency affect driver cognition during Vehicle-to-Vehicle (V2V) cooperative lane changes.',
    bullets: [
      'Contributed to the conceptualization and three-level operationalization of cooperative process transparency; curated and formally analysed performance and subjective data.',
      'Produced research visualizations and led manuscript preparation and revision.',
    ],
  },
  {
    period: '2024 - 2025',
    title: 'AR Social-Space Design through Interpersonal Distance and Social Cues',
    role: 'Co-Researcher, Tongji University',
    description:
      'Examines how virtual-agent layout, gesture amplitude, and interaction guidance shape affect, social presence, and continued engagement in AR.',
    bullets: [
      'Contributed to research conceptualization and curated and formally analysed the experimental data.',
      'Drafted the original manuscript and contributed to its review and revision.',
    ],
  },
  {
    period: '2024 - Present',
    title: 'Automated-Driving HMI and Driver Attention',
    role: 'Co-Researcher, Tongji University',
    description:
      'Comprises three driving-simulator studies of collaboration modes, monitoring requests, and multimodal takeover warnings.',
    bullets: [
      'Contributed to the design and execution of one controlled driving-simulator study; processed and analysed eye-tracking and fNIRS data across the project studies.',
      'Contributed to the interpretation of results and manuscript review and revision.',
    ],
  },
];

const designPractice = [
  {
    period: '2023 - Present',
    title: 'ExpoCraft – Reconstruction of Expo 2010 Shanghai',
    role: 'Independent Designer · Ongoing Project',
    description:
      'Reconstruct Expo 2010 Shanghai in Minecraft from maps, photographs and archival records; translate fragmented sources into a navigable spatial archive.',
  },
  {
    period: '2025',
    title: 'The Field of Seeds – Physical-Computing Installation',
    role: 'Co-Designer · Course Project',
    description:
      'Developed the concept, analysed the site and designed interactions/circuitry; co-built a wind/proximity-responsive Arduino prototype inspired by the UK Pavilion (Seed Cathedral) at Expo 2010 Shanghai.',
  },
  {
    period: '2025',
    title: 'Rooftop Garden – Site-Specific Interactive Projection',
    role: 'Independent Designer · Course Proposal',
    description:
      'Designed a projection proposal for a typhoon-displaced roof: passersby’s silhouettes trigger projected flowers, linking interaction with architectural memory.',
  },
  {
    period: '2024',
    title: 'Minetrarchi – Minecraft-Based Architectural Learning Game',
    role: 'Co-Designer · Design Concept',
    description:
      'Designed the concept, art, game mechanics and interactions for a Minecraft-based game concept teaching traditional Chinese timber architecture through guided tasks and free building.',
  },
];

const collaborations = [
  {
    period: '2025',
    title: 'Eye-Tracking Experiment and Analysis Coordinator',
    institution: 'Tongji University & Huawei Technologies Co., Ltd.',
    description:
      'Provided methodological training and supervised eye-tracking experiments and data analysis for an industry collaboration on task complexity in cloud change operations.',
  },
  {
    period: '2025 - 2026',
    title: 'EEG Data Analysis Coordinator',
    institution: 'Beijing Institute of Petrochemical Technology',
    description:
      'Supervised and conducted EEG data analysis for the project “Cognitive and Neural Mechanisms Underlying the Detection and Dissemination of AI-Generated Misinformation.”',
  },
];

const leadership = [
  {
    period: '2020 - 2023',
    title: 'Photojournalist; Co-Deputy Head & Head of Photography',
    institution: 'Jilin University Press Corps',
    description:
      'Led photographic reporting for campus news, cultural events and public communication.',
  },
  {
    period: '2020 - 2024',
    title: 'Deputy Head',
    institution: 'New Media Department, Physics Student Union, Jilin University',
    description:
      'Led college online communications and media presence; co-organised campus activities.',
  },
  {
    period: '2020 - 2022',
    title: 'Changchun Architectural Heritage Documentation',
    institution: 'Independent Researcher / Writer / Photographer',
    description:
      'Studied Changchun’s Japanese-colonial (Manchukuo-era) architecture through public history writing and field photography; advocated preservation. Individual articles reached 10,000+ reads and 100+ saves.',
  },
];

const skills = [
  { label: 'Experimental Methods', value: 'Driving Simulation · Eye Tracking · EEG/fNIRS Analysis' },
  { label: 'Research · Analysis', value: 'SPSS · MATLAB · GraphPad Prism · NVivo · Tobii Pro Lab' },
  { label: 'Programming · XR', value: 'Unity · Python · C/C++' },
  {
    label: 'Design · Media',
    value: 'Figma · Adobe Photoshop · Adobe Premiere Pro · Blender · SketchUp',
  },
  { label: 'Authoring', value: 'LaTeX' },
];

const [primaryProject, ...otherProjects] = projects;
---

<PageLayout
  title="Wang Zhaodong"
  description="Design Researcher, Master’s Candidate in Design"
  pageTitle="Academic Profile - Wang Zhaodong"
  pageClass="page--research"
  canonicalUrl="https://cv.tung.mockingbird.team/"
  domainScope="cv"
  mainSiteNavigation
  activeSection="research"
  contentCard
>
  <section slot="page-head" class="page-head cv-profile-card" aria-label="Academic profile">
    <img
      class="cv-web__avatar"
      src="/pictures/avatar.jpg"
      alt="Portrait of Wang Zhaodong"
      width="512"
      height="512"
      loading="lazy"
      decoding="async"
    />
    <div class="cv-profile-card__identity">
      <h1 class="page-title" data-mobile-brand-title>Wang Zhaodong</h1>
      <p class="cv-web__pronunciation">Pronounced roughly: Wong Jow-dong</p>
    </div>
    <div class="cv-web__profile">
      <p>
        Design researcher investigating and reimagining social relations in shared environments
        through discursive design, embodied inquiry and technological mediation.
      </p>
      <div class="cv-web__contact">
        <span>Shanghai, China</span>
        <a href="mailto:tungwang@tongji.edu.cn">tungwang@tongji.edu.cn</a>
        <a href="https://orcid.org/0009-0008-1111-6742" target="_blank" rel="noreferrer">
          ORCID 0009-0008-1111-6742
        </a>
        <a
          href="https://www.linkedin.com/in/zhaodong-wang-5311332a5/"
          target="_blank"
          rel="noreferrer">LinkedIn ↗</a
        >
        <a href="/files/Tung-Wang-CV.pdf" target="_blank" rel="noreferrer" data-main-site-link
          >Download CV ↓</a
        >
      </div>
    </div>
  </section>

  <div class="cv-web">
    <section class="cv-section cv-section--interests" id="research-interests">
      <h2>Research Interests</h2>
      <ul class="cv-interest-grid">
        <li>Public Space and Social Relations</li>
        <li>Discursive and Speculative Design</li>
        <li>Embodied Experience and Meaning-Making</li>
        <li>Human–Technology Relations and Design Methodology</li>
      </ul>
    </section>

    <section class="cv-section cv-section--education" id="formation">
      <h2>Education</h2>
      <div class="cv-entries">
        {
          education.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry__meta">{item.period}</div>
              <div class="cv-entry__heading">
                <h3>{item.degree}</h3>
                <strong class="cv-entry__institutions">
                  {item.institutions.map((institution, index) => (
                    <>
                      <a href={institution.href} target="_blank" rel="noreferrer">
                        {institution.label}
                      </a>
                      {index < item.institutions.length - 1 && <span>, </span>}
                    </>
                  ))}
                </strong>
              </div>
              <div class="cv-entry__content">
                {item.details.map((detail) => (
                  <p>{detail}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" id="projects">
      <h2>Selected Research<br />{' '}Projects</h2>
      <div class="cv-projects cv-projects--featured">
        <article class="cv-project cv-project--primary">
          <div class="cv-project__meta">
            <span>{primaryProject.period}</span>
            <strong>{primaryProject.role}</strong>
          </div>
          <h3>{primaryProject.title}</h3>
          {primaryProject.description && <p>{primaryProject.description}</p>}
          <ul>
            {primaryProject.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>

        {
          otherProjects.map((project) => (
            <article class="cv-project">
              <div class="cv-project__meta">
                <span>{project.period}</span>
                <strong>{project.role}</strong>
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <ul>
                {project.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" id="design-practice">
      <h2>Selected Design &<br />{' '}Spatial Practice</h2>
      <div class="cv-entries">
        {
          designPractice.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry__meta">{item.period}</div>
              <div class="cv-entry__heading">
                <h3>{item.title}</h3>
                <strong>{item.role}</strong>
              </div>
              <div class="cv-entry__content">
                <p>{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" id="publications">
      <h2>Publications &<br />{' '}Manuscripts</h2>
      <div class="cv-publications">
        {
          publications.map((publication) => (
            <article>
              <div class="cv-publications__main">
                <h3>{publication.title}</h3>
                <p class="cv-publications__authors">
                  {publication.before}
                  <strong>{publication.author}</strong>
                  {publication.after}
                </p>
              </div>
              <div class="cv-publications__details">
                <p class="cv-publications__status">
                  {publication.credit && <strong>{publication.credit}</strong>}
                  {(publication.status || publication.venue) && (
                    <span>
                      {publication.status && <b>{publication.status}</b>}{' '}
                      {publication.venue}
                    </span>
                  )}
                </p>
                {publication.note && <span>{publication.note}</span>}
                {publication.href && (
                  <a href={publication.href} target="_blank" rel="noreferrer">
                    {publication.linkLabel}
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" id="methods">
      <h2>Research Capabilities<br />{' '}& Technical Skills</h2>
      <div class="cv-methods-grid">
        <section>
          <h3>Research Capabilities</h3>
          <ul class="cv-plain-list">
            <li>First-Person / Qualitative Inquiry</li>
            <li>Conceptual & Relational Modelling</li>
            <li>Empirical-to-Design Translation</li>
            <li>Metaphor/Schema Analysis · XR Prototyping</li>
          </ul>
        </section>
        <section>
          <h3>Technical Skills</h3>
          <dl class="cv-skills">
            {
              skills.map((skill) => (
                <div>
                  <dt>{skill.label}</dt>
                  <dd>{skill.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>
    </section>

    <section class="cv-section">
      <h2>External Research<br />{' '}Collaborations</h2>
      <div class="cv-entries">
        {
          collaborations.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry__meta">{item.period}</div>
              <div class="cv-entry__heading">
                <h3>{item.title}</h3>
                <strong>{item.institution}</strong>
              </div>
              <div class="cv-entry__content">
                <p>{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" id="leadership">
      <h2>Leadership &<br />{' '}Cultural Engagement</h2>
      <div class="cv-entries">
        {
          leadership.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry__meta">{item.period}</div>
              <div class="cv-entry__heading">
                <h3>{item.title}</h3>
                <strong>{item.institution}</strong>
              </div>
              <div class="cv-entry__content">
                <p>{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section cv-section--languages">
      <h2>Languages</h2>
      <p class="cv-languages">
        <strong>Chinese</strong> - Native · <strong>English</strong> - Academic working proficiency ·{
          ' '
        }
        <strong>Japanese</strong> - Intermediate · <strong>French</strong> - Elementary
      </p>
    </section>

    <section class="cv-web__closing" aria-label="Academic links">
      <div class="cv-web__closing-inner">
        <p>Curriculum Vitae · Publications · Research Collaboration</p>
        <div>
          <a href="/files/Tung-Wang-CV.pdf" target="_blank" rel="noreferrer">Download CV ↓</a>
          <a href="https://orcid.org/0009-0008-1111-6742" target="_blank" rel="noreferrer"
            >ORCID ↗</a
          >
          <a href="mailto:tungwang@tongji.edu.cn">Email ↗</a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style lang="scss" is:global>
  @use '../styles/partials/academic';
</style>
