---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import MicroblogEntry from '../components/MicroblogEntry.astro';
import MicroblogAnchorKeeper from '../components/MicroblogAnchorKeeper.astro';

const rawEntries = (await getCollection('microblog', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
const entries = await Promise.all(
  rawEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { ...entry, Content };
  }),
);
---

<PageLayout
  title="Microblog"
  description="Short notes, images, links, and things still in motion."
  pageTitle="Tung’s Microblog"
  pageClass="microblog-page"
  lang="zh-CN"
  activeSection="microblog"
  contentCard
  headerLanguage="microblog"
>
  <div class="microblog-archive" data-microblog-scope data-language="zh" data-masonry-grid>
    {entries.map((entry) => <MicroblogEntry entry={entry} Content={entry.Content} />)}
  </div>
  <MicroblogAnchorKeeper />
  <div slot="after-main" class="masonry-boundary-mask masonry-boundary-mask--top" aria-hidden="true">
    <i class="masonry-boundary-mask__corner masonry-boundary-mask__corner--left-card"></i>
    <i class="masonry-boundary-mask__corner masonry-boundary-mask__corner--right-card"></i>
  </div>
  <div slot="after-main" class="masonry-boundary-mask masonry-boundary-mask--bottom" aria-hidden="true">
    <i class="masonry-boundary-mask__corner masonry-boundary-mask__corner--left-card"></i>
    <i class="masonry-boundary-mask__corner masonry-boundary-mask__corner--right-card"></i>
  </div>
</PageLayout>

<script>
  import '../scripts/masonry-grid';
  import '../scripts/masonry-boundary-clips';
</script>

<style lang="scss" is:global>
  @use '../styles/partials/microblog';
</style>
