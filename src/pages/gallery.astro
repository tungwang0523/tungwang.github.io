---
import PageLayout from '../layouts/PageLayout.astro';
import galleryData from '../data/gallery.json';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import { cloudflareImage } from '../utils/cloudflare-image.mjs';

interface GalleryPhoto {
  id: string;
  src: string;
  thumb: string;
  width: number;
  height: number;
  takenAt?: string;
  title?: { zh?: string; en?: string };
  caption?: { zh?: string; en?: string };
  location?: { zh?: string; en?: string };
  tags?: string[];
  exif?: {
    camera?: string;
    lens?: string;
    focalLength?: string;
    aperture?: string;
    shutter?: string;
    iso?: number;
    exposureCompensation?: string;
  };
  draft?: boolean;
}

const photos = (galleryData as GalleryPhoto[])
  .filter((photo) => !photo.draft)
  .sort((a, b) => (b.takenAt ?? '').localeCompare(a.takenAt ?? ''));

const parsedDate = (value?: string) => {
  if (!value) return undefined;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : date;
};

const formatDate = (value?: string) => {
  const date = parsedDate(value);
  if (!date) return undefined;
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
};

const years = new Map<string, GalleryPhoto[]>();
photos.forEach((photo) => {
  const date = parsedDate(photo.takenAt);
  const year = date ? String(date.getFullYear()) : 'Undated';
  const group = years.get(year) ?? [];
  group.push(photo);
  years.set(year, group);
});

const titleFor = (photo: GalleryPhoto) =>
  photo.title?.en || photo.title?.zh || photo.caption?.en || photo.caption?.zh;

const lightboxMobileSrcFor = (photo: GalleryPhoto) =>
  cloudflareImage(photo.src, {
    width: 1280,
    fit: 'scale-down',
    quality: 85,
    format: 'auto',
  });

const infoFor = (photo: GalleryPhoto) =>
  JSON.stringify({
    title: photo.title?.en || photo.title?.zh || '',
    caption: photo.caption?.en || photo.caption?.zh || '',
    location: photo.location?.en || photo.location?.zh || '',
    takenAt: photo.takenAt ?? '',
    width: photo.width,
    height: photo.height,
    tags: photo.tags ?? [],
    exif: photo.exif ?? null,
  });

const cameraFor = (photo: GalleryPhoto) => {
  const camera = photo.exif?.camera;
  if (!camera) return undefined;
  if (/nikon\s+d7100/i.test(camera)) return 'Nikon D7100';
  return camera;
};

const technicalLine = (photo: GalleryPhoto) =>
  [
    photo.exif?.focalLength,
    photo.exif?.aperture,
    photo.exif?.shutter,
    photo.exif?.iso ? `ISO ${photo.exif.iso}` : undefined,
  ]
    .filter(Boolean)
    .join(' · ');

const captionItems = (photo: GalleryPhoto) =>
  [
    titleFor(photo),
    photo.title && (photo.caption?.en || photo.caption?.zh),
    [photo.location?.en, formatDate(photo.takenAt)].filter(Boolean).join(' · '),
    [cameraFor(photo), photo.exif?.lens].filter(Boolean).join(' · '),
    technicalLine(photo),
  ].filter((item): item is string => Boolean(item));

const buttonLabelFor = (photo: GalleryPhoto) => {
  const details = [titleFor(photo), formatDate(photo.takenAt), photo.location?.en].filter(Boolean);
  return details.length > 0 ? `View photograph — ${details.join(', ')}` : 'View photograph';
};
---

<PageLayout
  title="Gallery"
  description="Photography by Tung Wang."
  pageTitle="Tung’s Gallery"
  pageClass="page--gallery"
  activeSection="gallery"
  titleInBrand
>
  {
    photos.length > 0 ? (
      <div class="gallery-archive" data-gallery-lightbox>
        {Array.from(years).map(([year, yearPhotos]) => (
          <section class="gallery-year" aria-labelledby={`gallery-year-${year}`}>
            <header class="gallery-year__header">
              <h2 id={`gallery-year-${year}`}>{year}</h2>
              <span>
                {yearPhotos.length} photograph{yearPhotos.length === 1 ? '' : 's'}
              </span>
            </header>

            <div class="gallery-wall" data-gallery-wall>
              {yearPhotos.map((photo) => {
                const title = titleFor(photo);
                const location = photo.location?.en;
                const date = formatDate(photo.takenAt);
                const camera = cameraFor(photo);
                return (
                  <figure
                    class="gallery-photo"
                    data-gallery-photo
                    data-gallery-ratio={photo.width / photo.height}
                  >
                    <button
                      class="gallery-photo__button"
                      type="button"
                      data-gallery-lightbox-image
                      data-gallery-lightbox-src={photo.src}
                      data-gallery-lightbox-mobile-src={lightboxMobileSrcFor(photo)}
                      data-gallery-lightbox-thumb={photo.thumb}
                      data-gallery-info={infoFor(photo)}
                      data-gallery-alt={title || 'Photograph by Tung Wang'}
                      aria-label={buttonLabelFor(photo)}
                    >
                      <img
                        src={photo.thumb}
                        width={photo.width}
                        height={photo.height}
                        alt={title || ''}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </button>
                    <figcaption>
                      {title && <strong class="gallery-photo__title">{title}</strong>}
                      {date && (
                        <span class="gallery-photo__date">
                          <time datetime={photo.takenAt}>{date}</time>
                        </span>
                      )}
                      {location && <span class="gallery-photo__location">{location}</span>}
                      {camera && <span class="gallery-photo__camera">{camera}</span>}
                    </figcaption>
                  </figure>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="gallery-empty">
        <strong>THE ARCHIVE IS BEING DEVELOPED.</strong>
        <span>Photographs will appear here as they are selected.</span>
      </div>
    )
  }
  <GalleryLightbox />
</PageLayout>
