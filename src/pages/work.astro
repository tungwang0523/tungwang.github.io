---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import WorkIndexCard from '../components/WorkIndexCard.astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProject = projects.find((project) => project.data.featured);
const regularProjects = projects.filter((project) => project !== featuredProject);
---

<PageLayout
  title="Work"
  description="Research-led design, playable architecture, and digital reconstruction projects by Tung Wang."
  pageTitle="Tung’s Work"
  pageClass="page--work"
  activeSection="work"
  contentCard
  titleInBrand
>
  <div class="work-index">
    {featuredProject && <WorkIndexCard {...featuredProject.data} featured priority />}
    <div class="work-index__grid" data-work-masonry>
      {regularProjects.map((project) => <WorkIndexCard {...project.data} />)}
    </div>
  </div>
  <div slot="after-main" class="work-boundary-mask work-boundary-mask--top" aria-hidden="true">
    <i class="work-boundary-mask__corner work-boundary-mask__corner--left-card"></i>
    <i class="work-boundary-mask__corner work-boundary-mask__corner--right-card"></i>
  </div>
  <div slot="after-main" class="work-boundary-mask work-boundary-mask--bottom" aria-hidden="true">
    <i class="work-boundary-mask__corner work-boundary-mask__corner--left-card"></i>
    <i class="work-boundary-mask__corner work-boundary-mask__corner--right-card"></i>
  </div>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-work-masonry]').forEach((grid) => {
    if (grid.dataset.masonryReady === 'true') return;
    grid.dataset.masonryReady = 'true';

    const tiles = Array.from(grid.children).filter(
      (child): child is HTMLElement => child instanceof HTMLElement,
    );
    let frame = 0;

    const layout = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        grid.classList.remove('is-masonry-ready');
        tiles.forEach((tile) => tile.style.removeProperty('grid-row-end'));

        if (window.matchMedia('(max-width: 760px)').matches) {
          return;
        }

        const heights = tiles.map((tile) => tile.getBoundingClientRect().height);

        grid.classList.add('is-masonry-ready');
        const styles = getComputedStyle(grid);
        const row = Number.parseFloat(styles.gridAutoRows) || 1;
        const gap = Number.parseFloat(styles.columnGap) || 12;

        tiles.forEach((tile, index) => {
          const span = Math.max(1, Math.ceil((heights[index] + gap) / row));
          tile.style.gridRowEnd = `span ${span}`;
        });
      });
    };

    const observer = new ResizeObserver(layout);
    observer.observe(grid);
    grid.querySelectorAll('img').forEach((image) => {
      if (!image.complete) image.addEventListener('load', layout, { once: true });
    });
    document.fonts?.ready.then(layout);
    layout();
  });

  const workPage = document.querySelector<HTMLElement>('.page--work.page--content-card');
  const workViewport = workPage?.querySelector<HTMLElement>('.page-content-card-viewport');
  const workTiles = Array.from(workPage?.querySelectorAll<HTMLElement>('.work-tile') ?? []);
  const topMask = workPage?.querySelector<HTMLElement>('.work-boundary-mask--top');
  const bottomMask = workPage?.querySelector<HTMLElement>('.work-boundary-mask--bottom');

  if (workPage && workViewport && topMask && bottomMask && workTiles.length > 0) {
    let clipFrame = 0;

    const updateBoundaryClips = () => {
      cancelAnimationFrame(clipFrame);
      clipFrame = requestAnimationFrame(() => {
        const viewport = workViewport.getBoundingClientRect();
        const center = (viewport.left + viewport.right) / 2;
        const tileRects = workTiles.map((tile) => tile.getBoundingClientRect());

        const updateMask = (mask: HTMLElement, boundary: number) => {
          let clipsLeftCard = false;
          let clipsRightCard = false;

          tileRects.forEach((rect) => {
            const crossesBoundary = rect.top < boundary && rect.bottom > boundary;
            const isColumnCard = rect.width < viewport.width * 0.75;
            if (!crossesBoundary || !isColumnCard) return;

            if ((rect.left + rect.right) / 2 < center) clipsLeftCard = true;
            else clipsRightCard = true;
          });

          mask
            .querySelector('.work-boundary-mask__corner--left-card')
            ?.classList.toggle('is-visible', clipsLeftCard);
          mask
            .querySelector('.work-boundary-mask__corner--right-card')
            ?.classList.toggle('is-visible', clipsRightCard);
        };

        updateMask(topMask, viewport.top);
        updateMask(bottomMask, viewport.bottom);
      });
    };

    workPage.addEventListener('scroll', updateBoundaryClips, { passive: true });
    window.addEventListener('resize', updateBoundaryClips, { passive: true });
    new ResizeObserver(updateBoundaryClips).observe(workViewport);
    document.fonts?.ready.then(updateBoundaryClips);
    updateBoundaryClips();
  }
</script>

<style lang="scss" is:global>
  @use '../styles/partials/work-index';
</style>
