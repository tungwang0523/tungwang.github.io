---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import WorkIndexCard from '../components/WorkIndexCard.astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProject = projects.find((project) => project.data.featured);
const regularProjects = projects.filter((project) => project !== featuredProject);
---

<PageLayout
  title="Work"
  description="Research-led design, playable architecture, and digital reconstruction projects by Tung Wang."
  pageTitle="Tung’s Work"
  pageClass="page--work"
  activeSection="work"
  contentCard
  titleInBrand
>
  <div class="work-index">
    {featuredProject && <WorkIndexCard {...featuredProject.data} featured priority />}
    <div class="work-index__grid" data-work-masonry>
      {regularProjects.map((project) => <WorkIndexCard {...project.data} />)}
    </div>
  </div>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-work-masonry]').forEach((grid) => {
    if (grid.dataset.masonryReady === 'true') return;
    grid.dataset.masonryReady = 'true';

    const tiles = Array.from(grid.children).filter(
      (child): child is HTMLElement => child instanceof HTMLElement,
    );
    let frame = 0;

    const layout = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        grid.classList.remove('is-masonry-ready');
        tiles.forEach((tile) => tile.style.removeProperty('grid-row-end'));

        if (window.matchMedia('(max-width: 760px)').matches) {
          return;
        }

        const styles = getComputedStyle(grid);
        const row = Number.parseFloat(styles.gridAutoRows) || 2;
        const gap = Number.parseFloat(styles.rowGap) || 12;

        const spans = tiles.map((tile) =>
          Math.max(1, Math.ceil((tile.getBoundingClientRect().height + gap) / (row + gap))),
        );

        grid.classList.add('is-masonry-ready');
        tiles.forEach((tile, index) => {
          tile.style.gridRowEnd = `span ${spans[index]}`;
        });
      });
    };

    const observer = new ResizeObserver(layout);
    observer.observe(grid);
    grid.querySelectorAll('img').forEach((image) => {
      if (!image.complete) image.addEventListener('load', layout, { once: true });
    });
    document.fonts?.ready.then(layout);
    layout();
  });
</script>

<style lang="scss" is:global>
  @use '../styles/partials/work-index';
</style>
