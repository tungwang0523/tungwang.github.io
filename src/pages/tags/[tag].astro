---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import {
  cloudflareImage,
  cloudflareSrcset,
  imagePresets,
} from '../../utils/cloudflare-image.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tags = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.add(t)));

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => +b.data.date - +a.data.date),
    },
  }));
}

const { tag, posts } = Astro.props;
const fmt = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;
const coverImage = (source: string) => cloudflareImage(source, {
  width: 640,
  fit: 'scale-down',
  quality: imagePresets.listing.quality,
  format: 'auto',
});
const coverSrcset = (source: string) => cloudflareSrcset(source, imagePresets.listing.widths, {
  fit: 'scale-down',
  quality: imagePresets.listing.quality,
  format: 'auto',
});
---

<PageLayout
  title={`#${tag}`}
  eyebrow="Tag"
  description={`${posts.length} essay${posts.length === 1 ? '' : 's'} tagged ${tag}.`}
  pageTitle={`#${tag} - Tung‘s Blog`}
  pageClass="blog-page"
  lang="zh-CN"
>
  <p><a href="/blog">← All essays</a></p>
  <div class="post-list">
    {
      posts.map((post) => (
        <a class="post-card" href={`/blog/${post.id}`}>
          <div class="post-card__cover">
            <img
              src={coverImage(post.data.cover)}
              srcset={coverSrcset(post.data.cover)}
              sizes={imagePresets.listing.sizes}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <div class="post-card__meta">
              {fmt(post.data.date)} · {post.data.author}
            </div>
            <h2 class="post-card__title">{post.data.bigTitle}</h2>
            <p class="post-card__excerpt">{post.data.excerpt}</p>
          </div>
        </a>
      ))
    }
  </div>
</PageLayout>
