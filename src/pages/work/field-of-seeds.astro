---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import FigureRow from '../../components/portfolio/FigureRow.astro';
import PortfolioSection from '../../components/portfolio/PortfolioSection.astro';
import PortfolioSectionHeader from '../../components/portfolio/PortfolioSectionHeader.astro';
import ProjectFigure from '../../components/portfolio/ProjectFigure.astro';
import ProjectHero from '../../components/portfolio/ProjectHero.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { cloudflareRemoteImage } from '../../utils/cloudflare-image.mjs';

const fieldBackdrop = import.meta.env.PROD
  ? cloudflareRemoteImage('/pictures/work/field-of-seeds/fos-p5-1.png', {
      width: 1920,
      fit: 'cover',
      quality: 85,
      format: 'auto',
    })
  : '/pictures/work/field-of-seeds/fos-p5-1.png';
const fieldClosingBackdrop = import.meta.env.PROD
  ? cloudflareRemoteImage('/pictures/work/field-of-seeds/fos-hero.png', {
      width: 1920,
      fit: 'cover',
      quality: 85,
      format: 'auto',
    })
  : '/pictures/work/field-of-seeds/fos-hero.png';
---

<ProjectLayout
  title="The Field of Seeds"
  subtitle="Thousands of light dandelions return to the lawn where the Seed Cathedral once stood."
  description="A physical-computing installation that replants light at the former site of Expo 2010's UK Pavilion."
  period="2024"
  kind="Physical Media & Computing Installation"
  status="Course project · team of three"
  role="Topic selection, concept definition & design, form design and circuit design"
  projectClass="portfolio-page--seeds"
  nextHref="/work/rooftop-garden"
  nextTitle="Rooftop Garden"
>
  <ProjectHero class="project-hero--seeds">
    <ResponsiveImage
      src="/pictures/work/field-of-seeds/fos-hero.png"
      alt="A field of light dandelions"
      priority
    />
    <p>The Seed Cathedral was dismantled. The memory stayed in the ground.</p>
  </ProjectHero>

  <PortfolioSection>
    <PortfolioSectionHeader title="The Seed Cathedral, Gone" />
    <p class="portfolio-copy portfolio-copy--flush">
      With its concept and form, the UK Pavilion's Seed Cathedral became one of the most memorable
      images of Expo 2010 Shanghai, leaving a unique impression on the city. After the Expo closed,
      the pavilion was dismantled, and its site is now a lawn.
    </p>
    <p class="portfolio-copy portfolio-copy--flush">
      This project makes a small attempt on that patch of green—so the city's Expo memory can keep
      spreading.
    </p>
    <ProjectFigure class="project-figure--white">
      <ResponsiveImage
        src="/pictures/work/field-of-seeds/fos-p2-1.png"
        alt="The UK Pavilion, the Seed Cathedral, Expo 2010 Shanghai"
      />
      <figcaption>The UK Pavilion — the Seed Cathedral — Expo 2010 Shanghai.</figcaption>
    </ProjectFigure>
  </PortfolioSection>

  <PortfolioSection class="portfolio-section--dark">
    <div class="portfolio-section__inner">
      <PortfolioSectionHeader title="The Site" />
      <p class="portfolio-copy portfolio-copy--flush">
        The former Expo C zone is now Expo Culture Park—the only large green park in Shanghai's
        central urban area, still serving the city for rest and landscape.
      </p>
      <p class="portfolio-copy portfolio-copy--flush">
        The former UK Pavilion site lies between the Shanghai Italy Center (former Italy Pavilion)
        and the Rodin Art Center (former France Pavilion): a riverside artificial lawn with trees.
      </p>
      <FigureRow class="figure-row--two">
        <figure>
          <ResponsiveImage
            src="/pictures/work/field-of-seeds/fos-p3-1.png"
            alt="Expo Culture Park, former Expo C zone"
          />
          <figcaption>Expo Culture Park, on the former Expo C zone.</figcaption>
        </figure>
        <figure>
          <ResponsiveImage
            src="/pictures/work/field-of-seeds/fos-p4-1.png"
            alt="The former UK Pavilion site, a riverside lawn"
          />
          <figcaption>The former UK Pavilion site, now a riverside lawn.</figcaption>
        </figure>
      </FigureRow>
    </div>
  </PortfolioSection>

  <PortfolioSection
    class="portfolio-section--backdrop"
    style={`background-image: url('${fieldBackdrop}')`}
  >
    <div class="portfolio-section__inner">
      <PortfolioSectionHeader title="Design Highlights" />
      <div class="method-architecture">
        <article>
          <small>I · Installation</small>
          <h3>A field of fluff</h3>
          <p>
            Thousands of thin optical fibers form dandelion fluff. When the wind blows, the fiber
            tips sway and light up; arranged across the lawn in large numbers, they become a field
            of dandelions.
          </p>
          <b>Wind + light</b>
        </article>
        <article>
          <small>II · Tribute & innovation</small>
          <h3>Nature and future</h3>
          <p>
            Inheriting the Seed Cathedral's theme, technology presents the beauty of natural force,
            carrying environmental and sustainable ideas and remembering the Expo.
          </p>
          <b>Memory</b>
        </article>
        <article>
          <small>III · Participation</small>
          <h3>Walk in and light up</h3>
          <p>Beyond the wind, people can approach a dandelion and light it themselves.</p>
          <b>Presence</b>
        </article>
      </div>
    </div>
  </PortfolioSection>

  <PortfolioSection>
    <PortfolioSectionHeader title="The Light Dandelion" />
    <p class="portfolio-copy portfolio-copy--flush">
      Each light dandelion is a central white LED inside a 3D-printed porous core and a translucent
      shell. When lit, light passes through the porous core and lands on the shell, where the array
      of bright rectangular patches mimics dandelion seed heads.
    </p>
    <FigureRow class="figure-row--portrait">
      <figure>
        <ResponsiveImage
          src="/pictures/work/field-of-seeds/fos-p6-2.png"
          alt="Model design draft"
        />
        <figcaption>Model design draft.</figcaption>
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p6-1.png" alt="Light effect" />
        <figcaption>Light effect.</figcaption>
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p6-3.png" alt="Prototype" />
        <figcaption>Single-unit prototype.</figcaption>
      </figure>
    </FigureRow>
    <FigureRow class="figure-row--uniform">
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p7-1.png" alt="Field render 1" />
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p8-1.png" alt="Field render 2" />
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p9-1.png" alt="Field render 3" />
      </figure>
    </FigureRow>
  </PortfolioSection>

  <PortfolioSection
    class="portfolio-section--backdrop portfolio-section--backdrop--spaced"
    style={`background-image: url('${fieldClosingBackdrop}')`}
  >
    <div class="portfolio-section__inner">
      <PortfolioSectionHeader title="Wind and Presence" />
      <p class="portfolio-copy portfolio-copy--flush">
        The device uses an Arduino UNO board to control the lights.
      </p>
      <p class="portfolio-copy portfolio-copy--flush">
        When a “light dandelion” sways in the wind, the tilt sensor sends a signal and the “light
        dandelion” lights up; when a person approaches a “light dandelion”, the infrared sensor
        sends a signal and the “light dandelion” lights up.
      </p>
      <p class="portfolio-copy portfolio-copy--flush">
        The “light dandelions” are arranged in an array across the former UK Pavilion site. When the
        wind blows, the whole “dandelion field” flickers with the wind's rhythm; participants in the
        field can also strengthen their presence in the field through light.
      </p>
    </div>
  </PortfolioSection>

  <PortfolioSection>
    <PortfolioSectionHeader title="Making" />
    <p class="portfolio-copy portfolio-copy--flush">
      The prototype combines a 3D-printed porous core and translucent shell, a flexible metal stand
      and wire supports, felt, artificial turf, a foam base, white LEDs, an infrared sensor, a tilt
      sensor, an Arduino UNO, a breadboard and wires.
    </p>
    <FigureRow class="figure-row--uniform">
      <figure>
        <ResponsiveImage
          src="/pictures/work/field-of-seeds/fos-p12-1.png"
          alt="The team assembling the base"
        />
        <figcaption>The team assembling the base</figcaption>
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p13-1.png" alt="Material 1" />
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p13-2.png" alt="Material 2" />
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p13-3.png" alt="Material 3" />
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p13-4.png" alt="Material 4" />
      </figure>
      <figure>
        <ResponsiveImage src="/pictures/work/field-of-seeds/fos-p13-5.png" alt="Material 5" />
      </figure>
    </FigureRow>
  </PortfolioSection>

  <PortfolioSection class="portfolio-section--closing">
    <div class="portfolio-section__label">What this is</div>
    <p class="portfolio-statement">
      A small field of light where a pavilion once stood—keeping the city's Expo memory alive in its
      only central green park.
    </p>
    <p class="portfolio-caption">
      The Field of Seeds was made with Li Tinghao and Xu Xuanzhi for the Physical Media and
      Computing course.
    </p>
  </PortfolioSection>
</ProjectLayout>
