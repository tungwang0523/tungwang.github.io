---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  period: string;
  kind: string;
  status: string;
  role?: string;
  projectClass?: string;
  nextHref?: string;
  nextTitle?: string;
}

const {
  title,
  subtitle,
  description,
  period,
  kind,
  status,
  role,
  projectClass,
  nextHref,
  nextTitle,
} = Astro.props;
---

<BaseLayout title={`${title} - Tung’s Work`} description={description}>
  <div class:list={['page', 'portfolio-page', projectClass]}>
    <Menu mobileOnly />
    <header class="page-nav">
      <div class="page-nav__inner">
        <a class="page-nav__brand" href="/">Tung’s</a>
        <nav aria-label="Primary">
          <a href="/academic" data-cv-site-link>Research</a>
          <a href="/work">Work</a>
          <a href="/blog">Blog</a>
          <a href="/microblog">Microblog</a>
          <a href="/gallery">Gallery</a>
        </nav>
      </div>
    </header>

    <main class="portfolio-main">
      <header class="portfolio-identity">
        <div class="portfolio-identity__inner">
          <a class="portfolio-back" href="/work"><span aria-hidden="true">←</span> Tung’s Work</a>
          <h1>{title}</h1>
          <p class="portfolio-subtitle">{subtitle}</p>
          <dl class="portfolio-meta">
            <div><dt>Period</dt><dd>{period}</dd></div>
            <div><dt>Type</dt><dd>{kind}</dd></div>
            <div><dt>Status</dt><dd>{status}</dd></div>
            {
              role && (
                <div>
                  <>
                    <dt>Role</dt>
                    <dd>{role}</dd>
                  </>
                </div>
              )
            }
          </dl>
        </div>
      </header>

      <slot />

      {
        nextHref && nextTitle && (
          <div class="portfolio-next">
            <a class="portfolio-next__back" href="/work">
              <span aria-hidden="true">←</span> Tung’s Work
            </a>
            <a class="portfolio-next__link" href={nextHref}>
              <div class="portfolio-next__inner">
                <span>Next project</span>
                <strong>{nextTitle}</strong>
                <span aria-hidden="true">&#8594;</span>
              </div>
            </a>
          </div>
        )
      }
    </main>

    <Footer />
  </div>
</BaseLayout>

<style lang="scss" is:global>
  @use '../styles/partials/youtube';
  @use '../styles/partials/portfolio-base';
  @use '../styles/partials/between-strangers';
  @use '../styles/partials/portfolio-media';
</style>
