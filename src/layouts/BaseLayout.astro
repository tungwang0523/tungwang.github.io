---
import DevScrollKeeper from '../components/DevScrollKeeper.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import YouTubeLoader from '../components/YouTubeLoader.astro';
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/400-italic.css';
import '@fontsource-variable/noto-sans-sc';
import '@fontsource/noto-serif-sc/chinese-simplified-400.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  canonicalUrl?: string;
  rootClass?: string;
  robots?: string;
  alternateLanguages?: Array<{ lang: string; href: string }>;
}

const {
  title = 'Tung’s',
  description = 'The personal website of Tung Wang, an interdisciplinary researcher and designer.',
  image,
  lang = 'en',
  canonicalUrl,
  rootClass,
  robots,
  alternateLanguages = [],
} = Astro.props;

const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).toString() : undefined;
const isDev = import.meta.env.DEV;
const rootClasses = rootClass?.split(/\s+/) ?? [];
const themeColor = rootClasses.includes('blog-paper')
  ? '#000000'
  : rootClasses.includes('gallery-page-root')
    ? '#000000'
    : rootClasses.includes('home-page')
      ? '#dddad9'
      : rootClasses.includes('content-card-page')
        ? '#dddad9'
        : '#e9e6e4';
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://tung.mockingbird.team/#website',
      url: 'https://tung.mockingbird.team/',
      name: 'Tung Wang',
      inLanguage: ['en', 'zh-CN'],
    },
    {
      '@type': 'Person',
      '@id': 'https://tung.mockingbird.team/#person',
      name: 'Wang Zhaodong',
      alternateName: 'Tung Wang',
      url: 'https://tung.mockingbird.team/',
      sameAs: ['https://orcid.org/0009-0008-1111-6742'],
    },
  ],
};
---

<!doctype html>
<html lang={lang} class={rootClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="dns-prefetch" href="//img.mockingbird.team" />
    <link rel="preconnect" href="https://img.mockingbird.team" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="canonical" href={canonical} />
    {
      alternateLanguages.map(({ lang: alternateLang, href }) => (
        <link
          rel="alternate"
          hreflang={alternateLang}
          href={new URL(href, Astro.site ?? Astro.url).toString()}
        />
      ))
    }
    <link rel="alternate" type="application/rss+xml" title="Tung’s" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tung Wang" />
    <meta property="og:locale" content={lang.startsWith('zh') ? 'zh_CN' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <title>{title}</title>
    <script is:inline>
      (() => {
        const websiteId = 'c34be2b1-006c-48bc-9249-fcf0712c144d';
        const productionHosts = new Set(['tung.mockingbird.team', 'cv.tung.mockingbird.team']);
        const optOutKey = 'tungs-analytics-disabled';
        const optOutCookie = `${optOutKey}=true`;
        const url = new URL(window.location.href);
        const preference = url.searchParams.get('analytics');

        if (preference === 'off') {
          localStorage.setItem(optOutKey, 'true');
          document.cookie = `${optOutCookie}; Max-Age=31536000; Path=/; Domain=.tung.mockingbird.team; SameSite=Lax; Secure`;
        }
        if (preference === 'on') {
          localStorage.removeItem(optOutKey);
          document.cookie = `${optOutKey}=; Max-Age=0; Path=/; Domain=.tung.mockingbird.team; SameSite=Lax; Secure`;
        }

        if (preference === 'off' || preference === 'on') {
          url.searchParams.delete('analytics');
          history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
        }

        if (
          !productionHosts.has(window.location.hostname) ||
          localStorage.getItem(optOutKey) === 'true' ||
          document.cookie.split('; ').includes(optOutCookie)
        ) {
          return;
        }

        const tracker = document.createElement('script');
        tracker.defer = true;
        tracker.src = '/stats/script.js';
        tracker.dataset.websiteId = websiteId;
        tracker.dataset.domains = [...productionHosts].join(',');
        document.head.appendChild(tracker);

        let activeStartedAt = document.visibilityState === 'visible' ? performance.now() : null;
        let activeMilliseconds = 0;
        let lastReportedSecond = 0;

        const updateActiveTime = () => {
          if (activeStartedAt === null) return;
          activeMilliseconds += performance.now() - activeStartedAt;
          activeStartedAt = null;
        };

        const reportActiveTime = () => {
          updateActiveTime();
          const seconds = Math.round(activeMilliseconds / 1000);
          if (seconds < 2 || seconds === lastReportedSecond || !window.umami?.track) return;

          lastReportedSecond = seconds;
          window.umami.track('page-engagement', {
            path: window.location.pathname,
            seconds,
          });
        };

        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') {
            reportActiveTime();
          } else if (activeStartedAt === null) {
            activeStartedAt = performance.now();
          }
        });
        window.addEventListener('pagehide', reportActiveTime);
      })();
    </script>
    <script is:inline data-enabled={rootClass === 'home-page'}>
      (() => {
        if (document.currentScript?.dataset.enabled !== 'true') return;
        const updateHomeViewportHeight = () => {
          const height = window.visualViewport?.height ?? window.innerHeight;
          document.documentElement.style.setProperty(
            '--home-viewport-height',
            `${Math.round(height)}px`,
          );
        };

        updateHomeViewportHeight();
        window.visualViewport?.addEventListener('resize', updateHomeViewportHeight);
        window.addEventListener('resize', updateHomeViewportHeight);
        window.addEventListener('orientationchange', () => {
          window.setTimeout(updateHomeViewportHeight, 120);
        });
      })();
    </script>
    <script is:inline data-enabled={rootClasses.includes('content-card-page')}>
      (() => {
        if (document.currentScript?.dataset.enabled !== 'true') return;
        const updateContentCardViewport = () => {
          const viewport = window.visualViewport;
          const height = viewport?.height ?? window.innerHeight;
          document.documentElement.style.setProperty(
            '--content-card-viewport-height',
            `${Math.round(height)}px`,
          );
        };

        let refreshFrame = 0;
        const refreshContentCard = () => {
          updateContentCardViewport();

          const page = document.querySelector('.page--content-card');
          if (!(page instanceof HTMLElement)) return;

          const previousTop = page.scrollTop;
          page.classList.add('is-layout-refreshing');
          void page.offsetHeight;

          cancelAnimationFrame(refreshFrame);
          refreshFrame = requestAnimationFrame(() => {
            page.classList.remove('is-layout-refreshing');
            const maximumTop = Math.max(0, page.scrollHeight - page.clientHeight);
            page.scrollTop = Math.min(previousTop, maximumTop);
            updateContentCardViewport();
          });
        };

        updateContentCardViewport();
        window.addEventListener('content-card:refresh', refreshContentCard);
        window.visualViewport?.addEventListener('resize', updateContentCardViewport);
        window.addEventListener('resize', updateContentCardViewport);
        window.addEventListener('orientationchange', () => {
          window.setTimeout(updateContentCardViewport, 120);
        });
      })();
    </script>
    {isDev && <DevScrollKeeper />}
  </head>
  <body class={rootClass}>
    <slot />
    <ImageLightbox />
    <YouTubeLoader />
    <script is:inline>
      (() => {
        const { hostname, protocol, port } = window.location;
        const isLocal =
          hostname === 'localhost' ||
          hostname === '127.0.0.1' ||
          hostname === '::1' ||
          hostname.endsWith('.localhost') ||
          hostname.endsWith('.vercel.app');

        if (isLocal) return;

        const cvPrefixes = ['cv.', 'academic.'];
        const activePrefix = cvPrefixes.find((prefix) => hostname.startsWith(prefix));
        const mainHostname = activePrefix
          ? hostname.slice(activePrefix.length)
          : hostname.replace(/^www\./, '');
        const cvHostname = activePrefix ? hostname : `cv.${mainHostname}`;
        const cvOrigin = `${protocol}//${cvHostname}${port ? `:${port}` : ''}`;

        document.querySelectorAll('[data-cv-site-link]').forEach((link) => {
          link.setAttribute('href', new URL('/', cvOrigin).href);
        });
      })();

      document.addEventListener('contextmenu', (event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      });
      document.addEventListener('dragstart', (event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      });
    </script>
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/global.scss';
</style>
