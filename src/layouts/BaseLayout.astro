---
import DevScrollKeeper from '../components/DevScrollKeeper.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Tung‘s',
  description = 'The personal website of Tung Wang, an interdisciplinary researcher and designer.',
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).toString() : undefined;
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="dns-prefetch" href="//img.mockingbird.team" />
    <link rel="preconnect" href="https://img.mockingbird.team" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Tung‘s" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <title>{title}</title>
    {isDev && <DevScrollKeeper />}
  </head>
  <body>
    <slot />
    <script is:inline>
      document.addEventListener('contextmenu', (event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      });
      document.addEventListener('dragstart', (event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      });

      // Anchor jumps: clear the sticky nav, and re-correct while lazy images
      // load (they have no reserved height and shift the target downward).
      (() => {
        const navOffset = () => {
          const raw = getComputedStyle(document.documentElement).getPropertyValue('--page-nav-height');
          return (Number.parseFloat(raw) || 0) + 16;
        };
        const findTarget = () => {
          const id = decodeURIComponent(location.hash.slice(1));
          return id ? document.getElementById(id) : null;
        };
        const jump = (behavior) => {
          const el = findTarget();
          if (!el) return;
          const top = window.scrollY + el.getBoundingClientRect().top - navOffset();
          window.scrollTo({ top: Math.max(0, top), behavior });
        };
        if (location.hash.length > 1) {
          [0, 150, 500, 1200, 2500].forEach((delay) => setTimeout(() => jump('auto'), delay));
          window.addEventListener('load', () => jump('auto'), { once: true });
          if (findTarget()) {
            let timer = 0;
            const correct = () => {
              clearTimeout(timer);
              timer = setTimeout(() => jump('auto'), 60);
            };
            document.querySelectorAll('img').forEach((img) => {
              if (!img.complete) img.addEventListener('load', correct, { once: true });
            });
          }
        }
        window.addEventListener('hashchange', () => jump('smooth'));
      })();
    </script>
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/global.scss';
</style>
