---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import { cloudflareImage, cloudflareSrcset, imagePresets } from '../utils/cloudflare-image.mjs';

interface Props {
  title: string;
  description?: string;
  descriptionLines?: string[];
  eyebrow?: string;
  heroImage?: string;
  pageTitle?: string;
  pageClass?: string;
  lang?: string;
  blogHref?: string;
  canonicalUrl?: string;
  mainSiteNavigation?: boolean;
  activeSection?: 'research' | 'work' | 'blog' | 'microblog';
}

const {
  title,
  description,
  heroImage,
  pageTitle,
  pageClass,
  lang = 'en',
  blogHref = '/blog',
  canonicalUrl,
  mainSiteNavigation = false,
  activeSection,
} = Astro.props;
const headTitle = pageTitle ?? `${title} - Tung‘s`;
const heroSrc = heroImage
  ? cloudflareImage(heroImage, {
      width: 960,
      fit: 'cover',
      quality: imagePresets.hero.quality,
      format: 'auto',
    })
  : undefined;
const heroSrcset = heroImage
  ? cloudflareSrcset(heroImage, imagePresets.hero.widths, {
      fit: 'cover',
      quality: imagePresets.hero.quality,
      format: 'auto',
    })
  : undefined;
---

<BaseLayout
  title={headTitle}
  description={description}
  image={heroImage}
  lang={lang}
  canonicalUrl={canonicalUrl}
>
  <div class:list={['page', pageClass]}>
    <Menu
      mobileOnly
      activeSection={activeSection}
      mainSiteNavigation={mainSiteNavigation}
      blogHref={blogHref}
    />
    <header class="page-nav">
      <div class="page-nav__inner">
        <a class="page-nav__brand" href="/" data-main-site-link={mainSiteNavigation || undefined}
          >Tung’s</a
        >
        <nav aria-label="Primary">
          {
            activeSection === 'research' ? (
              <span class="page-nav__current" aria-current="page">Research</span>
            ) : (
              <a href="/academic" data-cv-site-link>Research</a>
            )
          }
          {
            activeSection === 'work' ? (
              <span class="page-nav__current" aria-current="page">Work</span>
            ) : (
              <a href="/work" data-main-site-link={mainSiteNavigation || undefined}>Work</a>
            )
          }
          {
            activeSection === 'blog' ? (
              <span class="page-nav__current" aria-current="page">Blog</span>
            ) : (
              <a href={blogHref} data-main-site-link={mainSiteNavigation || undefined}>Blog</a>
            )
          }
          {
            activeSection === 'microblog' ? (
              <span class="page-nav__current" aria-current="page">Microblog</span>
            ) : (
              <a href="/microblog" data-main-site-link={mainSiteNavigation || undefined}>Microblog</a>
            )
          }
        </nav>
      </div>
    </header>

    <main class="page-main">
      {
        heroImage && (
          <div class="page-hero">
            <img
              src={heroSrc}
              srcset={heroSrcset}
              sizes={heroSrcset ? imagePresets.hero.sizes : undefined}
              alt=""
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }

      <section class="page-head">
        <h1 class="page-title">{title}</h1>
      </section>

      <div class="page-body">
        <slot />
      </div>
    </main>

    <Footer
      blogHref={blogHref}
      mainSiteNavigation={mainSiteNavigation}
      activeSection={activeSection}
    />
  </div>
</BaseLayout>

{
  mainSiteNavigation && (
    <script is:inline>
      (() => {
        const prefixes = ['cv.', 'academic.'];
        const prefix = prefixes.find((value) => window.location.hostname.startsWith(value));
        if (!prefix) return;

        const hostname = window.location.hostname.slice(prefix.length);
        const port = window.location.port ? `:${window.location.port}` : '';
        const origin = `${window.location.protocol}//${hostname}${port}`;

        document.querySelectorAll('[data-main-site-link]').forEach((link) => {
          const href = link.getAttribute('href');
          if (href?.startsWith('/')) link.setAttribute('href', new URL(href, origin).href);
        });
      })();
    </script>
  )
}
