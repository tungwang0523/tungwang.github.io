---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  descriptionLines?: string[];
  eyebrow?: string;
  heroImage?: string;
  pageTitle?: string;
  pageClass?: string;
}

const { title, description, descriptionLines, eyebrow, heroImage, pageTitle, pageClass } = Astro.props;
const headTitle = pageTitle ?? `${title} — Tung’s`;
---

<BaseLayout title={headTitle} description={description} image={heroImage}>
  <div class:list={['page', pageClass]}>
    <header class="page-nav">
      <div class="page-nav__inner">
        <a class="page-nav__brand" href="/">Tung’s</a>
        <nav aria-label="Primary">
          <a href="/academic">Research</a>
        <a href="/work">Work</a>
        <a href="/blog">Blog</a>
        <a href="/microblog">Microblog</a>
        <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main class="page-main">
      {
        heroImage && (
          <div class="page-hero">
            <img src={heroImage} alt="" />
          </div>
        )
      }

      <section class="page-head">
        {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
        <h1 class="page-title">{title}</h1>
        {(description || descriptionLines) && (
          <p class:list={['page-deck', { 'page-deck--lines': descriptionLines }]}>
            {descriptionLines
              ? descriptionLines.map((line) => <span>{line}</span>)
              : description}
          </p>
        )}
      </section>

      <div class="page-body">
        <slot />
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
