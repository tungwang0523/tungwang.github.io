---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { cloudflareImage, cloudflareSrcset, imagePresets } from '../utils/cloudflare-image.mjs';

interface Props {
  title: string;
  description?: string;
  descriptionLines?: string[];
  eyebrow?: string;
  heroImage?: string;
  pageTitle?: string;
  pageClass?: string;
  lang?: string;
  blogHref?: string;
  canonicalUrl?: string;
}

const {
  title,
  description,
  heroImage,
  pageTitle,
  pageClass,
  lang = 'en',
  blogHref = '/blog',
  canonicalUrl,
} = Astro.props;
const headTitle = pageTitle ?? `${title} - Tung‘s`;
const heroSrc = heroImage
  ? cloudflareImage(heroImage, {
      width: 960,
      fit: 'cover',
      quality: imagePresets.hero.quality,
      format: 'auto',
    })
  : undefined;
const heroSrcset = heroImage
  ? cloudflareSrcset(heroImage, imagePresets.hero.widths, {
      fit: 'cover',
      quality: imagePresets.hero.quality,
      format: 'auto',
    })
  : undefined;
---

<BaseLayout
  title={headTitle}
  description={description}
  image={heroImage}
  lang={lang}
  canonicalUrl={canonicalUrl}
>
  <div class:list={['page', pageClass]}>
    <header class="page-nav">
      <div class="page-nav__inner">
        <a class="page-nav__brand" href="/">Tung’s</a>
        <nav aria-label="Primary">
          <a href="https://cv.tung.mockingbird.team/">Research</a>
          <a href="/work">Work</a>
          <a href={blogHref}>Blog</a>
          <a href="/microblog">Microblog</a>
        </nav>
      </div>
    </header>

    <main class="page-main">
      {
        heroImage && (
          <div class="page-hero">
            <img
              src={heroSrc}
              srcset={heroSrcset}
              sizes={heroSrcset ? imagePresets.hero.sizes : undefined}
              alt=""
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }

      <section class="page-head">
        <h1 class="page-title">{title}</h1>
      </section>

      <div class="page-body">
        <slot />
      </div>
    </main>

    <Footer blogHref={blogHref} />
  </div>
</BaseLayout>
