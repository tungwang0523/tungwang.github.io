---
import BaseLayout from './BaseLayout.astro';
import Menu from '../components/Menu.astro';
import BlogLanguageToggle from '../components/BlogLanguageToggle.astro';
import MicroblogLanguageToggle from '../components/MicroblogLanguageToggle.astro';
import { cloudflareImage, cloudflareSrcset, imagePresets } from '../utils/cloudflare-image.mjs';
import { imageDimensionsFor } from '../utils/image-dimensions.mjs';

interface Props {
  title: string;
  description?: string;
  heroImage?: string;
  pageTitle?: string;
  pageClass?: string;
  lang?: string;
  blogHref?: string;
  canonicalUrl?: string;
  alternateLanguages?: Array<{ lang: string; href: string }>;
  domainScope?: 'main' | 'cv';
  mainSiteNavigation?: boolean;
  activeSection?: 'research' | 'work' | 'gallery' | 'blog' | 'microblog';
  contentCard?: boolean;
  headerLanguage?: 'blog' | 'microblog';
  languageCurrent?: 'zh' | 'en';
  languageZhHref?: string;
  languageEnHref?: string;
  titleInBrand?: boolean;
}

const {
  title,
  description,
  heroImage,
  pageTitle,
  pageClass,
  lang = 'en',
  blogHref = '/blog',
  canonicalUrl,
  alternateLanguages,
  domainScope,
  mainSiteNavigation = false,
  activeSection,
  contentCard = false,
  headerLanguage,
  languageCurrent = 'zh',
  languageZhHref,
  languageEnHref,
  titleInBrand = false,
} = Astro.props;
const headTitle = pageTitle ?? `${title} - Tung’s`;
const isBlogPost = pageClass?.split(/\s+/).includes('blog-post-page') ?? false;
const hasBlogToc = pageClass?.split(/\s+/).includes('has-blog-toc') ?? false;
const rootClass = [
  isBlogPost && `blog-paper${hasBlogToc ? ' blog-paper-has-toc' : ''}`,
  contentCard && 'content-card-page',
  activeSection === 'gallery' && 'gallery-page-root',
]
  .filter(Boolean)
  .join(' ');
const hasAdaptiveSectionBrand = contentCard || titleInBrand || activeSection === 'research';
const isSectionLanding = Boolean(activeSection) && !isBlogPost;
const sectionTitle = activeSection
  ? {
      research: 'Research',
      work: 'Work',
      blog: 'Blog',
      microblog: 'Microblog',
      gallery: 'Gallery',
    }[activeSection]
  : undefined;
const sectionHref =
  activeSection === 'research' ? '/academic' : activeSection ? `/${activeSection}` : '/';
const normalizedPathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navigationSectionHref = activeSection === 'research' ? '/academic' : `/${activeSection}`;
const navigationActiveSection =
  activeSection && normalizedPathname === navigationSectionHref ? activeSection : undefined;
const mobileBrandExpanded =
  activeSection === 'research'
    ? 'Tung’s Research'
    : activeSection === 'work'
      ? 'Tung’s Work'
      : activeSection === 'gallery'
        ? 'Tung’s Gallery'
        : activeSection === 'blog'
          ? 'Tung’s Blog'
          : activeSection === 'microblog'
            ? 'Tung’s Microblog'
            : undefined;
const heroSrc = heroImage
  ? cloudflareImage(heroImage, {
      width: 960,
      fit: 'cover',
      quality: imagePresets.hero.quality,
      format: 'auto',
    })
  : undefined;
const heroSrcset = heroImage
  ? cloudflareSrcset(heroImage, imagePresets.hero.widths, {
      fit: 'cover',
      quality: imagePresets.hero.quality,
      format: 'auto',
    })
  : undefined;
const heroDimensions = heroImage ? imageDimensionsFor(heroImage) : undefined;
---

<BaseLayout
  title={headTitle}
  description={description}
  image={heroImage}
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateLanguages={alternateLanguages}
  domainScope={domainScope}
  rootClass={rootClass || undefined}
>
  <div
    class:list={[
      'page',
      pageClass,
      contentCard && 'page--content-card',
      isSectionLanding && 'page--section-landing',
    ]}
  >
    {isBlogPost && <div class="blog-paper-viewport-top" aria-hidden="true" />}
    {isBlogPost && <div class="blog-paper-viewport-bottom" aria-hidden="true" />}
    {contentCard && <div class="page-content-card-viewport" aria-hidden="true" />}
    <Menu
      mobileOnly
      activeSection={navigationActiveSection}
      mainSiteNavigation={mainSiteNavigation}
      blogHref={blogHref}
      showHome={false}
      showIdentity
      showDesktopBrand
      mobileBrandExpanded={mobileBrandExpanded}
      mobileBrandExpandedAlways={activeSection === 'research' || titleInBrand}
      mobileBrandHomeBeforeTitle={hasAdaptiveSectionBrand}
      mobileBrandHref={titleInBrand ? sectionHref : '/'}
    >
      {
        headerLanguage && (
          <div class="page-header-language page-header-language--mobile">
            {headerLanguage === 'blog' ? (
              <BlogLanguageToggle
                current={languageCurrent}
                zhHref={languageZhHref}
                enHref={languageEnHref}
              />
            ) : (
              <MicroblogLanguageToggle />
            )}
          </div>
        )
      }
    </Menu>
    <header class="page-nav">
      <div class="page-nav__inner">
        <a
          class="page-nav__brand"
          href="/"
          aria-label="Home"
          data-main-site-link={mainSiteNavigation || undefined}
        >
          Tung’s
        </a>
        <div class="page-nav__controls">
          <nav aria-label="Primary">
            {
              navigationActiveSection === 'research' ? (
                <span class="page-nav__current" aria-current="page">
                  Research
                </span>
              ) : (
                <a href="/academic" data-cv-site-link>
                  Research
                </a>
              )
            }
            {
              navigationActiveSection === 'work' ? (
                <span class="page-nav__current" aria-current="page">
                  Work
                </span>
              ) : (
                <a href="/work" data-main-site-link={mainSiteNavigation || undefined}>
                  Work
                </a>
              )
            }
            {
              navigationActiveSection === 'blog' ? (
                <span class="page-nav__current" aria-current="page">
                  Blog
                </span>
              ) : (
                <a href={blogHref} data-main-site-link={mainSiteNavigation || undefined}>
                  Blog
                </a>
              )
            }
            {
              navigationActiveSection === 'microblog' ? (
                <span class="page-nav__current" aria-current="page">
                  Microblog
                </span>
              ) : (
                <a href="/microblog" data-main-site-link={mainSiteNavigation || undefined}>
                  Microblog
                </a>
              )
            }
            {
              navigationActiveSection === 'gallery' ? (
                <span class="page-nav__current" aria-current="page">
                  Gallery
                </span>
              ) : (
                <a href="/gallery" data-main-site-link={mainSiteNavigation || undefined}>
                  Gallery
                </a>
              )
            }
          </nav>
          {
            headerLanguage && (
              <div class="page-header-language page-header-language--desktop">
                {headerLanguage === 'blog' ? (
                  <BlogLanguageToggle
                    current={languageCurrent}
                    zhHref={languageZhHref}
                    enHref={languageEnHref}
                  />
                ) : (
                  <MicroblogLanguageToggle />
                )}
              </div>
            )
          }
        </div>
        <div class="page-nav__identity blog-menu mention">
          <img class="mention__mark" src="/favicon.svg?v=2" alt="" width="44" height="44" />
          <span class="mention__name">Tung Wang</span>
          <small class="mention__role">
            Founder of{' '}
            <a href="https://mockingbird.team" target="_blank" rel="noreferrer">
              Mockingbird Studio
            </a>
          </small>
          <span class="mention__details">
            <small>Greetings from Shanghai</small>
            <small>© 2026 Tung Wang</small>
          </span>
        </div>
      </div>
    </header>

    {isSectionLanding && sectionTitle && <h1 class="page-section-title">{sectionTitle}</h1>}

    <slot name="after-nav" />

    <main class="page-main">
      <slot name="before-head" />

      {
        heroImage && (
          <div class="page-hero">
            <img
              src={heroSrc}
              srcset={heroSrcset}
              sizes={heroSrcset ? imagePresets.hero.sizes : undefined}
              alt=""
              width={heroDimensions?.width}
              height={heroDimensions?.height}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }

      <slot name="page-head">
        <section class:list={['page-head', titleInBrand && 'page-head--in-brand']}>
          <h1 class="page-title" data-mobile-brand-title>{title}</h1>
        </section>
      </slot>

      <div class="page-body">
        <slot />
      </div>
    </main>

    <slot name="after-main" />

  </div>
</BaseLayout>

<script is:inline data-enabled={mainSiteNavigation}>
  (() => {
    if (document.currentScript?.dataset.enabled !== 'true') return;
    const prefixes = ['cv.', 'academic.'];
    const prefix = prefixes.find((value) => window.location.hostname.startsWith(value));
    if (!prefix) return;

    const hostname = window.location.hostname.slice(prefix.length);
    const port = window.location.port ? `:${window.location.port}` : '';
    const origin = `${window.location.protocol}//${hostname}${port}`;

    document.querySelectorAll('[data-main-site-link]').forEach((link) => {
      const href = link.getAttribute('href');
      if (href?.startsWith('/')) link.setAttribute('href', new URL(href, origin).href);
    });
  })();
</script>
