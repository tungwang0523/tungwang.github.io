---
import { formatSiteDate } from '../utils/date';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  bigTitle: string;
  date?: Date;
  dateLabel?: string;
  emphasis?: string;
  headline: string;
  cover: string;
  author: string;
  readTime: string;
  excerpt: string;
  href: string;
  linkSite?: 'main' | 'cv';
  hasNext?: boolean;
  imageLoading?: 'eager' | 'lazy';
  imageFetchPriority?: 'high' | 'low' | 'auto';
}

const {
  bigTitle,
  date,
  dateLabel,
  emphasis,
  headline,
  cover,
  author,
  readTime,
  excerpt,
  href,
  linkSite = 'main',
  hasNext = false,
  imageLoading = 'lazy',
  imageFetchPriority = 'low',
} = Astro.props;

const formatted = dateLabel ?? (date ? formatSiteDate(date) : '');
const sectionId = bigTitle.toLowerCase();
const compactCover =
  sectionId === 'writing'
    ? '/pictures/writing_small.png'
    : sectionId === 'gallery'
      ? '/pictures/gallery_small.png?v=2'
      : undefined;

const parts = emphasis ? headline.split('{emphasis}') : [headline];
---

<div class="blog-header" data-section={sectionId}>
  <div class="blog-article header-article">
    <div class="blog-big__title">{bigTitle}</div>
    <div class="blog-menu small-title date">{formatted}</div>
  </div>
  <div class="blog-article featured-content">
    <div class="featured-content__media">
      <ResponsiveImage
        class="featured-content__image"
        src={cover}
        alternateSrc={compactCover}
        alt={bigTitle}
        widths={[480, 768, 960, 1440]}
        sizes="(max-width: 800px) calc(100vw - 48px), 50vw"
        priority={imageLoading === 'eager'}
        loading={imageLoading}
        decoding="async"
        fetchpriority={imageFetchPriority}
        data-section={sectionId}
      />
    </div>
    <div class="featured-content__copy">
      <h2>
        {
          emphasis ? (
            <>
              {parts[0]}
              <span>{emphasis}</span>
              {parts[1]}
            </>
          ) : (
            headline
          )
        }
      </h2>
      <p>{excerpt}</p>
      <div class="featured-content__actions">
        {
          hasNext && (
            <button type="button" data-featured-next aria-label="Scroll to the next section">
              Next{' '}
              <span class="featured-next__arrow" aria-hidden="true">
                ↓
              </span>
            </button>
          )
        }
        <a href={href} data-cv-site-link={linkSite === 'cv' || undefined}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M15 10l5 5-5 5"></path>
            <path d="M4 4v7a4 4 0 004 4h12"></path>
          </svg>
          See More
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const getAvailableMediaHeight = (content: HTMLElement, copy: HTMLElement) => {
    const styles = window.getComputedStyle(content);
    const paddingTop = Number.parseFloat(styles.paddingTop) || 0;
    const paddingBottom = Number.parseFloat(styles.paddingBottom) || 0;
    return Math.max(0, content.clientHeight - paddingTop - paddingBottom - copy.offsetHeight);
  };

  const scheduleResearchLayout = (() => {
    let frame = 0;

    return (header: HTMLElement) => {
      if (frame) window.cancelAnimationFrame(frame);
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        const content = header.querySelector<HTMLElement>('.featured-content');
        const media = header.querySelector<HTMLElement>('.featured-content__media');
        const copy = header.querySelector<HTMLElement>('.featured-content__copy');
        if (!content || !media || !copy || !media.clientWidth) return;

        const fullArtworkHeight = (media.clientWidth * 3) / 4;
        const availableHeight = getAvailableMediaHeight(content, copy);
        media.style.setProperty(
          '--research-media-height',
          `${Math.min(fullArtworkHeight, availableHeight)}px`,
        );
        media.dataset.researchLayout = 'true';
      });
    };
  })();

  document
    .querySelectorAll<HTMLElement>(".blog-header[data-section='research']")
    .forEach((header) => {
      if (header.dataset.researchLayoutReady === 'true') return;
      header.dataset.researchLayoutReady = 'true';

      const observer = new ResizeObserver(() => scheduleResearchLayout(header));
      observer.observe(header);
      const copy = header.querySelector<HTMLElement>('.featured-content__copy');
      if (copy) observer.observe(copy);
      scheduleResearchLayout(header);
    });

  const scheduleWorkCrop = (() => {
    let frame = 0;

    return (header: HTMLElement) => {
      if (frame) window.cancelAnimationFrame(frame);
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        const content = header.querySelector<HTMLElement>('.featured-content');
        const media = header.querySelector<HTMLElement>('.featured-content__media');
        const copy = header.querySelector<HTMLElement>('.featured-content__copy');
        if (!content || !media || !copy) return;

        const imageWidth = media.clientWidth;
        if (!imageWidth) return;

        // work.png is a 4:3 canvas built from six exact 512px-high rows.
        const rowHeight = (imageWidth * 3) / 4 / 6;
        const availableHeight = getAvailableMediaHeight(content, copy);
        // Change rows near their visual midpoint instead of as soon as the
        // next complete row is a fraction short. This keeps the crop from
        // feeling premature while preserving the artwork's whole-row rhythm.
        const rowCount = Math.max(2, Math.min(6, Math.round(availableHeight / rowHeight)));
        const firstVisibleRow = Math.floor((6 - rowCount) / 2);
        const retainedRowOverflow = Math.max(0, rowCount * rowHeight - availableHeight);

        media.dataset.workCrop = 'true';
        media.style.setProperty('--work-crop-height', `${rowCount * rowHeight}px`);
        media.style.setProperty('--work-first-row', String(firstVisibleRow));
        copy.style.setProperty('--work-copy-overflow', `${retainedRowOverflow}px`);
      });
    };
  })();

  document.querySelectorAll<HTMLElement>(".blog-header[data-section='works']").forEach((header) => {
    if (header.dataset.workCropReady === 'true') return;
    header.dataset.workCropReady = 'true';

    const observer = new ResizeObserver(() => scheduleWorkCrop(header));
    observer.observe(header);
    const copy = header.querySelector<HTMLElement>('.featured-content__copy');
    if (copy) observer.observe(copy);
    scheduleWorkCrop(header);
  });

  document
    .querySelectorAll<HTMLElement>(
      ".blog-header[data-section='writing'], .blog-header[data-section='gallery']",
    )
    .forEach((header) => {
      if (header.dataset.writingArtworkReady === 'true') return;
      header.dataset.writingArtworkReady = 'true';

      // Each header owns its own animation frame so the writing and gallery
      // sections never cancel each other's pending layout pass.
      let frame = 0;
      const schedule = () => {
        if (frame) window.cancelAnimationFrame(frame);
        frame = window.requestAnimationFrame(() => {
          frame = 0;
          const content = header.querySelector<HTMLElement>('.featured-content');
          const media = header.querySelector<HTMLElement>('.featured-content__media');
          const copy = header.querySelector<HTMLElement>('.featured-content__copy');
          const image = header.querySelector<HTMLImageElement>('.featured-content__image');
          if (!content || !media || !copy || !image) return;

          const fullSource = image.dataset.fullSrc;
          const compactSource = image.dataset.compactSrc;
          const imageWidth = media.clientWidth;
          if (!fullSource || !compactSource || !imageWidth) return;

          const availableHeight = getAvailableMediaHeight(content, copy);
          const fullArtworkHeight = (imageWidth * 3) / 4;
          const useCompactArtwork = availableHeight + 1 < fullArtworkHeight;
          const nextSource = useCompactArtwork ? compactSource : fullSource;
          const nextSrcset = useCompactArtwork
            ? image.dataset.compactSrcset
            : image.dataset.fullSrcset;
          const nextMode = useCompactArtwork ? 'compact' : 'full';

          if (image.dataset.artworkSource !== nextMode) {
            image.src = nextSource;
            if (nextSrcset) image.srcset = nextSrcset;
            else image.removeAttribute('srcset');
            image.dataset.artworkSource = nextMode;
          }
          header.dataset.artwork = useCompactArtwork ? 'compact' : 'full';
        });
      };

      const observer = new ResizeObserver(schedule);
      observer.observe(header);
      const copy = header.querySelector<HTMLElement>('.featured-content__copy');
      if (copy) observer.observe(copy);
      schedule();
    });

  const featuredStage = document.querySelector<HTMLElement>('[data-mobile-featured]');

  if (featuredStage && featuredStage.dataset.imageAlignmentReady !== 'true') {
    featuredStage.dataset.imageAlignmentReady = 'true';
    const headers = Array.from(
      featuredStage.querySelectorAll<HTMLElement>('.blog-header[data-section]'),
    );
    let alignmentFrame = 0;

    const alignImages = () => {
      alignmentFrame = 0;
      const mobileTitle =
        featuredStage.querySelector<HTMLElement>('.mobile-featured__brand') ??
        featuredStage.querySelector<HTMLElement>('.mobile-featured__title');
      const useMobileTitle = window.matchMedia('(max-width: 768px)').matches;

      headers.forEach((header) => {
        const title = useMobileTitle
          ? mobileTitle
          : header.querySelector<HTMLElement>('.blog-big__title');
        const media = header.querySelector<HTMLElement>('.featured-content__media');
        const image = header.querySelector<HTMLImageElement>('.featured-content__image');
        const subtitle = header.querySelector<HTMLElement>('.featured-content__copy h2');
        if (!title || !media || !image || !subtitle) return;

        const previousOffset =
          Number.parseFloat(media.style.getPropertyValue('--featured-image-offset')) || 0;
        const titleBottom = title.getBoundingClientRect().bottom;
        const subtitleTop = subtitle.getBoundingClientRect().top;
        const visualBounds =
          media.dataset.workCrop === 'true'
            ? media.getBoundingClientRect()
            : image.getBoundingClientRect();
        const unshiftedCenter = (visualBounds.top + visualBounds.bottom) / 2 - previousOffset;
        // Centre the artwork in the clear vertical interval between the two
        // text regions. Using the subtitle's bottom pulled multi-line cards
        // progressively lower than their visual centre.
        const targetCenter = (titleBottom + subtitleTop) / 2;

        media.style.setProperty(
          '--featured-image-offset',
          `${(targetCenter - unshiftedCenter).toFixed(2)}px`,
        );
      });
    };

    const scheduleImageAlignment = () => {
      if (alignmentFrame) window.cancelAnimationFrame(alignmentFrame);
      alignmentFrame = window.requestAnimationFrame(alignImages);
    };

    const alignmentObserver = new ResizeObserver(scheduleImageAlignment);
    alignmentObserver.observe(featuredStage);
    headers.forEach((header) => {
      const media = header.querySelector<HTMLElement>('.featured-content__media');
      const image = header.querySelector<HTMLImageElement>('.featured-content__image');
      const subtitle = header.querySelector<HTMLElement>('.featured-content__copy h2');
      if (media) alignmentObserver.observe(media);
      if (image) {
        alignmentObserver.observe(image);
        image.addEventListener('load', scheduleImageAlignment);
      }
      if (subtitle) alignmentObserver.observe(subtitle);
    });

    document.fonts.ready.then(scheduleImageAlignment);
    window.addEventListener('resize', scheduleImageAlignment, { passive: true });
    scheduleImageAlignment();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>('[data-featured-next]');
    if (!button) return;

    const current = button.closest<HTMLElement>('.blog-header');
    const next = current?.nextElementSibling;
    if (!(next instanceof HTMLElement)) return;

    next.scrollIntoView({
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      block: 'start',
    });
  });
</script>
