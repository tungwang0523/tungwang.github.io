---
import type { CollectionEntry } from 'astro:content';
import { cloudflareImage, cloudflareSrcset, imagePresets } from '../utils/cloudflare-image.mjs';
import { calculateReadingTime } from '../utils/reading-time';
import { formatSiteDate } from '../utils/date';
import { imageDimensionsFor } from '../utils/image-dimensions.mjs';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const cardTitle = post.data.listTitle ?? post.data.title;
const readTime = calculateReadingTime(post.body);
const cover = cloudflareImage(post.data.cover, {
  width: 640,
  fit: 'scale-down',
  quality: imagePresets.listing.quality,
  format: 'auto',
});
const srcset = cloudflareSrcset(post.data.cover, imagePresets.listing.widths, {
  fit: 'scale-down',
  quality: imagePresets.listing.quality,
  format: 'auto',
});
const coverDimensions = imageDimensionsFor(post.data.cover);
---

<a class="post-card" href={`/blog/${post.id}`}>
  <div class="post-card__cover">
    <img
      src={cover}
      srcset={srcset}
      sizes={imagePresets.listing.sizes}
      alt=""
      width={coverDimensions?.width}
      height={coverDimensions?.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="post-card__body">
    <div class="post-card__meta">
      {formatSiteDate(post.data.date)} · {post.data.author} · {readTime}
    </div>
    <h2 class="post-card__title">
      {cardTitle}
    </h2>
    <p class="post-card__excerpt">{post.data.excerpt}</p>
  </div>
</a>
