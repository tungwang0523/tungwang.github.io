---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang?: 'zh' | 'en';
  variant?: 'both' | 'desktop' | 'mobile';
}

const { headings, lang = 'zh', variant = 'both' } = Astro.props;
const items = headings.filter(
  (heading) => heading.depth >= 1 && heading.depth <= 3 && heading.text.trim().length > 0,
);
const visible = items.length >= 3;
const label = lang === 'en' ? 'Contents' : '目录';
---

{
  visible && (
    <>
      {variant !== 'mobile' && (
        <aside
          class="blog-toc blog-toc--desktop"
          data-blog-toc
          data-blog-toc-desktop
          data-toc-has-before="false"
          data-toc-has-after="false"
          aria-label={label}
        >
          <div class="blog-toc__label">{label}</div>
          <ol data-blog-toc-list>
            {items.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )}

      {variant !== 'desktop' && (
        <details
          class="blog-toc-mobile"
          data-blog-toc-mobile
          data-blog-toc
          data-toc-has-before="false"
          data-toc-has-after="false"
        >
          <summary>
            <span class="blog-toc-mobile__label">{label}</span>
            <span class="blog-toc-mobile__current" data-toc-current>
              {items[0]?.text}
            </span>
            <span class="blog-toc-mobile__arrow" aria-hidden="true">
              ↓
            </span>
          </summary>
          <nav aria-label={label}>
            <ol>
              {items.map((heading) => (
                <li data-depth={heading.depth}>
                  <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}
    </>
  )
}

<script src="../scripts/blog-table-of-contents.ts"></script>
