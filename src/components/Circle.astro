---
interface Props {
  title?: string;
  titleEn?: string;
  subtitle?: string;
  subtitleEn?: string;
  cta?: string;
  ctaEn?: string;
  href?: string;
  showArrow?: boolean;
}

const {
  title = 'Leave Your Old Life Behind',
  titleEn = title,
  subtitle = "Don't try to be like someone else, be yourself. Be secure with yourself.",
  subtitleEn = subtitle,
  cta = 'Explore',
  ctaEn = cta,
  href,
  showArrow = false,
} = Astro.props;
---

{
  href ? (
    <a class="circle" href={href}>
      <div class="circle-title">
        <>
          <span data-copy-language="zh">{title}</span>
          <span data-copy-language="en">{titleEn}</span>
        </>
      </div>
      {subtitle && (
        <div class="circle-subtitle">
          <span data-copy-language="zh">{subtitle}</span>
          <span data-copy-language="en">{subtitleEn}</span>
        </div>
      )}
      <div class="circle-footer">
        <>
          <span data-copy-language="zh">{cta}</span>
          <span data-copy-language="en">{ctaEn}</span>
        </>
        {showArrow && (
          <svg class="circle-footer__arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5l14 14M5 19h14V5" />
          </svg>
        )}
      </div>
    </a>
  ) : (
    <div class="circle">
      <div class="circle-title">
        <>
          <span data-copy-language="zh">{title}</span>
          <span data-copy-language="en">{titleEn}</span>
        </>
      </div>
      {subtitle && (
        <div class="circle-subtitle">
          <span data-copy-language="zh">{subtitle}</span>
          <span data-copy-language="en">{subtitleEn}</span>
        </div>
      )}
      <div class="circle-footer">
        <>
          <span data-copy-language="zh">{cta}</span>
          <span data-copy-language="en">{ctaEn}</span>
        </>
        {showArrow && (
          <svg class="circle-footer__arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5l14 14M5 19h14V5" />
          </svg>
        )}
      </div>
    </div>
  )
}
