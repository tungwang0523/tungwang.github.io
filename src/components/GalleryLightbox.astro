---
// Gallery lightbox: dedicated viewer for the photography archive.
// Image loading follows the shared mechanism (preview first, preload the
// full source, decode, preload neighbours, mobile-resolution variant),
// but the layout and information panel are specific to the gallery.
---

<dialog class="gallery-lightbox" data-gallery-lightbox-dialog aria-label="Gallery photograph">
  <div class="gallery-lightbox__stage">
    <img class="gallery-lightbox__image" alt="" decoding="async" draggable="false" />
    <span class="gallery-lightbox__spinner" aria-hidden="true"></span>
    <button class="gallery-lightbox__close" type="button" aria-label="Close photograph">×</button>
    <button
      class="gallery-lightbox__nav gallery-lightbox__nav--prev"
      type="button"
      aria-label="Previous photograph"
    >
      <span class="gallery-lightbox__nav-icon" aria-hidden="true">↓</span>
    </button>
    <button
      class="gallery-lightbox__nav gallery-lightbox__nav--next"
      type="button"
      aria-label="Next photograph"
    >
      <span class="gallery-lightbox__nav-icon" aria-hidden="true">↓</span>
    </button>
  </div>
  <aside class="gallery-lightbox__info" aria-label="Photograph information" data-gallery-info>
    <button
      class="gallery-lightbox__toggle"
      type="button"
      aria-expanded="false"
      data-gallery-info-toggle
    >
      <span class="gallery-lightbox__toggle-text">
        <span class="gallery-lightbox__toggle-title" data-gallery-info-toggle-title>Details</span>
        <span class="gallery-lightbox__toggle-meta" data-gallery-info-toggle-meta></span>
      </span>
      <span class="gallery-lightbox__toggle-icon" aria-hidden="true">↓</span>
    </button>
    <div class="gallery-lightbox__content" data-gallery-info-content>
    <div class="gallery-lightbox__heading">
      <h2 class="gallery-lightbox__title"></h2>
      <p class="gallery-lightbox__caption"></p>
      <p class="gallery-lightbox__meta"></p>
    </div>
    <div class="gallery-lightbox__exif" hidden>
      <p class="gallery-lightbox__details-label">Details</p>
    </div>
    <div class="gallery-lightbox__footer">
      <span class="gallery-lightbox__counter" aria-live="polite"></span>
    </div>
    </div>
  </aside>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-lightbox-dialog]');

  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>('.gallery-lightbox__image');
    const stage = dialog.querySelector<HTMLElement>('.gallery-lightbox__stage');
    const titleEl = dialog.querySelector<HTMLElement>('.gallery-lightbox__title');
    const captionEl = dialog.querySelector<HTMLElement>('.gallery-lightbox__caption');
    const metaEl = dialog.querySelector<HTMLElement>('.gallery-lightbox__meta');
    const exifEl = dialog.querySelector<HTMLElement>('.gallery-lightbox__exif');
    const counterEl = dialog.querySelector<HTMLElement>('.gallery-lightbox__counter');
    const infoPanel = dialog.querySelector<HTMLElement>('.gallery-lightbox__info');
    const toggle = dialog.querySelector<HTMLButtonElement>('.gallery-lightbox__toggle');
    const toggleTitle = dialog.querySelector<HTMLElement>('[data-gallery-info-toggle-title]');
    const toggleMeta = dialog.querySelector<HTMLElement>('[data-gallery-info-toggle-meta]');
    const infoContent = dialog.querySelector<HTMLElement>('[data-gallery-info-content]');

    // Mobile accordion: animate max-height, then release it so the content
    // fills the card and the Details block stays bottom-aligned. Desktop
    // never constrains the content.
    // Mobile: the accordion keeps the content at its own height. Desktop
    // never constrains it, so the flex layout fills the card and the
    // Details block stays bottom-aligned (PC only).
    // Re-measure the expanded info card after its content changes
    // (photo switching), so the card height follows the new content.
    const syncInfoHeight = () => {
      if (!infoContent) return;
      if (!window.matchMedia('(max-width: 900px)').matches) return;
      if (!infoPanel?.classList.contains('is-expanded')) return;
      infoContent.style.maxHeight = `${infoContent.scrollHeight}px`;
    };

    const setInfoExpanded = (nowExpanded: boolean) => {
      infoPanel?.classList.toggle('is-expanded', nowExpanded);
      dialog.classList.toggle('is-info-collapsed', !nowExpanded);
      toggle?.setAttribute('aria-expanded', String(nowExpanded));
      applyInfo(nowExpanded);
    };

    const applyInfo = (expanded: boolean) => {
      if (!infoContent) return;
      if (!window.matchMedia('(max-width: 900px)').matches) {
        infoContent.style.maxHeight = '';
        return;
      }
      infoContent.style.maxHeight = expanded ? `${infoContent.scrollHeight}px` : '0px';
    };
    const close = dialog.querySelector<HTMLButtonElement>('.gallery-lightbox__close');
    const previous = dialog.querySelector<HTMLButtonElement>('.gallery-lightbox__nav--prev');
    const next = dialog.querySelector<HTMLButtonElement>('.gallery-lightbox__nav--next');

    let items: HTMLElement[] = [];
    let activeIndex = 0;
    let requestId = 0;
    let switching = false;
    let lastTrigger: HTMLElement | null = null;
    let touchStartX: number | null = null;
    let touchStartY: number | null = null;
    const preloads = new Map<string, Promise<boolean>>();

    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const sourceFor = (trigger: HTMLElement) =>
      (window.matchMedia('(max-width: 768px)').matches
        ? trigger.dataset.galleryLightboxMobileSrc
        : trigger.dataset.galleryLightboxSrc) ||
      trigger.dataset.galleryLightboxSrc ||
      '';

    const previewFor = (trigger: HTMLElement) =>
      trigger.dataset.galleryLightboxThumb || sourceFor(trigger);

    const parseInfo = (trigger: HTMLElement) => {
      try {
        return JSON.parse(trigger.dataset.galleryInfo || '{}') || {};
      } catch {
        return {};
      }
    };

    const formatTaken = (iso?: string) => {
      if (!iso) return '';
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return '';
      const pad = (value: number) => String(value).padStart(2, '0');
      return `${date.getFullYear()}.${pad(date.getMonth() + 1)}.${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
    };

    const exifRows = (info: Record<string, unknown>) => {
      const exif = (info.exif || {}) as Record<string, unknown>;
      const rows: Array<[string, string]> = [];
      const add = (label: string, value: unknown, prefix = '') => {
        const text = value === undefined || value === null ? '' : `${prefix}${String(value)}`.trim();
        if (text) rows.push([label, text]);
      };
      add('Camera', exif.camera);
      add('Lens', exif.lens);
      add('Focal length', exif.focalLength);
      add('Aperture', exif.aperture);
      add('Shutter', exif.shutter);
      add('ISO', exif.iso, 'ISO ');
      add('Exposure compensation', exif.exposureCompensation);
      return rows;
    };

    const renderInfo = (trigger: HTMLElement) => {
      const info = parseInfo(trigger);
      if (titleEl) {
        titleEl.textContent = info.title || '';
        titleEl.hidden = !info.title;
      }
      if (toggleTitle) {
        toggleTitle.textContent = info.title || 'Details';
      }
      if (toggleMeta) {
        const meta = [
          formatTaken(info.takenAt),
          info.location,
          info.exif?.camera,
        ].filter(Boolean).join(' · ');
        toggleMeta.textContent = meta;
        toggleMeta.hidden = !meta;
      }
      if (captionEl) {
        captionEl.textContent = info.caption || '';
        captionEl.hidden = !info.caption;
      }
      if (metaEl) {
        metaEl.replaceChildren();
        const place = document.createElement('span');
        place.className = 'gallery-lightbox__place';
        place.textContent = info.location || '';
        place.hidden = !info.location;
        const date = document.createElement('span');
        date.className = 'gallery-lightbox__date';
        const formatted = formatTaken(info.takenAt);
        date.textContent = formatted;
        date.hidden = !formatted;
        metaEl.append(place, date);
        metaEl.hidden = !info.location && !formatted;
      }
      if (exifEl) {
        const rows = exifRows(info);
        exifEl.replaceChildren();
        const detailsLabel = document.createElement('p');
        detailsLabel.className = 'gallery-lightbox__details-label';
        detailsLabel.textContent = 'Details';
        exifEl.append(detailsLabel);
        rows.forEach(([label, value]) => {
          const field = document.createElement('div');
          field.className = 'gallery-lightbox__field';
          if (label === 'Lens' || label === 'Exposure compensation') {
            field.classList.add('gallery-lightbox__field--wide');
          }
          if (
            label === 'Focal length' ||
            label === 'Aperture' ||
            label === 'Shutter' ||
            label === 'ISO' ||
            label === 'Exposure compensation'
          ) {
            field.classList.add('gallery-lightbox__field--stat');
          }
          const caption = document.createElement('span');
          caption.textContent = label;
          const detail = document.createElement('strong');
          detail.textContent = value;
          field.append(caption, detail);
          exifEl.append(field);
        });
        exifEl.hidden = rows.length === 0;
      }
    };

    const preload = (source: string) => {
      const existing = preloads.get(source);
      if (existing) return existing;
      const request = new Promise<boolean>((resolve) => {
        const loader = new Image();
        loader.onload = () => resolve(true);
        loader.onerror = () => resolve(false);
        loader.src = source;
      });
      preloads.set(source, request);
      return request;
    };

    const preloadNeighbours = (index: number) => {
      [items[index - 1], items[index + 1]].forEach((neighbour) => {
        if (neighbour) void preload(sourceFor(neighbour));
      });
    };

    const setLoading = (loading: boolean) => {
      stage?.classList.toggle('is-loading', loading);
      image?.classList.toggle('is-loading', loading);
    };

    const render = (index: number, displaySource: string) => {
      const trigger = items[index];
      if (!trigger || !image || !counterEl || !previous || !next) return;
      activeIndex = index;
      renderInfo(trigger);
      syncInfoHeight();
      image.src = displaySource;
      image.alt = trigger.dataset.galleryAlt || '';
      counterEl.textContent = `${index + 1} / ${items.length}`;
      previous.disabled = index === 0;
      next.disabled = index === items.length - 1;
      dialog.setAttribute('aria-label', `Gallery photograph ${index + 1} of ${items.length}`);
    };

    // Mobile: capture the collapsed image box size once so expanding the
    // card moves the image up instead of shrinking it.
    const freezeImageSize = () => {
      if (!image) return;
      if (!window.matchMedia('(max-width: 900px)').matches) return;
      requestAnimationFrame(() => {
        const rect = image.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          image.style.width = `${Math.round(rect.width)}px`;
          image.style.height = `${Math.round(rect.height)}px`;
        }
      });
    };

    const show = () => {
      dialog.classList.remove('is-closing');
      document.body.style.overflow = 'hidden';
      dialog.showModal();
      requestAnimationFrame(() =>
        requestAnimationFrame(() => dialog.classList.add('is-visible')),
      );
      close?.focus();
    };

    const hide = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      requestId += 1;
      if (reducedMotion()) {
        dialog.close();
        return;
      }
      dialog.classList.add('is-closing');
      dialog.classList.remove('is-visible');
      window.setTimeout(() => {
        if (dialog.open) dialog.close();
      }, 180);
    };

    const open = (trigger: HTMLElement) => {
      lastTrigger = trigger;
      const scope = trigger.closest<HTMLElement>('[data-gallery-lightbox]');
      items = scope
        ? Array.from(scope.querySelectorAll<HTMLElement>('[data-gallery-lightbox-image]'))
        : [trigger];
      const index = Math.max(0, items.indexOf(trigger));
      const fullSource = sourceFor(trigger);
      const currentRequest = ++requestId;

      render(index, previewFor(trigger));
      const mobileLayout = window.matchMedia('(max-width: 900px)').matches;
      setInfoExpanded(!mobileLayout);
      setLoading(true);
      show();
      freezeImageSize();

      if (fullSource) {
        void preload(fullSource).then(async (loaded) => {
          if (
            !loaded ||
            currentRequest !== requestId ||
            activeIndex !== index ||
            !dialog.open ||
            !image
          )
            return;
          image.src = fullSource;
          await image.decode().catch(() => undefined);
          setLoading(false);
          preloadNeighbours(index);
        });
      } else {
        setLoading(false);
      }
    };

    const move = async (direction: -1 | 1) => {
      const nextIndex = activeIndex + direction;
      if (nextIndex < 0 || nextIndex >= items.length || switching || !image || !stage) return;
      const trigger = items[nextIndex];
      if (!trigger) return;
      const nextSource = sourceFor(trigger);
      if (!nextSource) return;

      switching = true;
      const currentRequest = ++requestId;
      const outgoing = reducedMotion()
        ? null
        : image.animate(
            [
              { opacity: 1 },
              { opacity: 0 },
            ],
            { duration: 110, easing: 'ease-in', fill: 'forwards' },
          );
      await outgoing?.finished.catch(() => undefined);
      if (currentRequest !== requestId || !dialog.open) {
        outgoing?.cancel();
        switching = false;
        return;
      }

      setLoading(true);
      render(nextIndex, previewFor(trigger));
      outgoing?.cancel();
      switching = false;

      const loaded = await preload(nextSource);
      if (currentRequest !== requestId || !dialog.open) return;
      if (!image) return;
      image.src = nextSource;
      await image.decode().catch(() => undefined);
      setLoading(false);
      if (!loaded) return;
      preloadNeighbours(nextIndex);
      if (reducedMotion()) return;
      await image
        .animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: 'ease-out' })
        .finished.catch(() => undefined);
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const trigger = target.closest<HTMLElement>('[data-gallery-lightbox-image]');
      if (trigger) {
        event.preventDefault();
        open(trigger);
        return;
      }
      if (!dialog.open) return;
      if (target.closest('.gallery-lightbox__nav--prev')) void move(-1);
      if (target.closest('.gallery-lightbox__nav--next')) void move(1);
    });

    document.addEventListener('keydown', (event) => {
      if (!dialog.open) {
        const trigger = (event.target as HTMLElement)?.closest<HTMLElement>(
          '[data-gallery-lightbox-image]',
        );
        if (trigger && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault();
          open(trigger);
        }
        return;
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        void move(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        void move(1);
      }
    });

    dialog.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.changedTouches[0];
        if (!touch) return;
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true },
    );

    dialog.addEventListener(
      'touchend',
      (event) => {
        const touch = event.changedTouches[0];
        if (!touch || touchStartX === null || touchStartY === null) return;
        const distanceX = touch.clientX - touchStartX;
        const distanceY = touch.clientY - touchStartY;
        touchStartX = null;
        touchStartY = null;
        if (Math.abs(distanceX) >= 48 && Math.abs(distanceX) > Math.abs(distanceY)) {
          void move(distanceX < 0 ? 1 : -1);
          return;
        }
        // Vertical swipe on mobile: up expands the info card, down collapses it.
        if (
          Math.abs(distanceY) >= 48 &&
          Math.abs(distanceY) > Math.abs(distanceX) &&
          window.matchMedia('(max-width: 900px)').matches
        ) {
          setInfoExpanded(distanceY < 0);
        }
      },
      { passive: true },
    );

    toggle?.addEventListener('click', () => {
      const nowExpanded = infoPanel?.classList.toggle('is-expanded') ?? false;
      setInfoExpanded(nowExpanded);
    });

    close?.addEventListener('click', hide);
    dialog.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.gallery-lightbox__image')) return;
      if (target.closest('.gallery-lightbox__nav')) return;
      if (target.closest('.gallery-lightbox__info')) return;
      if (target.closest('.gallery-lightbox__close')) return;
      hide();
    });
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      hide();
    });
    dialog.addEventListener('close', () => {
      dialog.classList.remove('is-visible', 'is-closing');
      document.body.style.overflow = '';
      setLoading(false);
      switching = false;
      lastTrigger?.focus();
    });
  }
</script>
