---
// Gallery lightbox: dedicated viewer for the photography archive.
// Image loading follows the shared mechanism (preview first, preload the
// full source, decode, preload neighbours, mobile-resolution variant),
// but the layout and information panel are specific to the gallery.
---

<dialog class="gallery-lightbox" data-gallery-lightbox-dialog aria-label="Gallery photograph">
  <div class="gallery-lightbox__stage">
    <img class="gallery-lightbox__image" alt="" decoding="async" draggable="false" />
    <span class="gallery-lightbox__spinner" aria-hidden="true"></span>
    <button class="gallery-lightbox__close" type="button" aria-label="Close photograph">×</button>
    <button
      class="gallery-lightbox__nav gallery-lightbox__nav--prev"
      type="button"
      aria-label="Previous photograph"
    >
      <span class="gallery-lightbox__nav-icon" aria-hidden="true">↓</span>
    </button>
    <button
      class="gallery-lightbox__nav gallery-lightbox__nav--next"
      type="button"
      aria-label="Next photograph"
    >
      <span class="gallery-lightbox__nav-icon" aria-hidden="true">↓</span>
    </button>
  </div>
  <aside class="gallery-lightbox__info" aria-label="Photograph information" data-gallery-info>
    <button
      class="gallery-lightbox__toggle"
      type="button"
      aria-expanded="false"
      data-gallery-info-toggle
    >
      <span class="gallery-lightbox__toggle-text">
        <span class="gallery-lightbox__toggle-title" data-gallery-info-toggle-title>Details</span>
        <span class="gallery-lightbox__toggle-meta" data-gallery-info-toggle-meta></span>
      </span>
      <span class="gallery-lightbox__toggle-icon" aria-hidden="true">↓</span>
    </button>
    <div class="gallery-lightbox__content" data-gallery-info-content>
      <div class="gallery-lightbox__heading">
        <h2 class="gallery-lightbox__title"></h2>
        <p class="gallery-lightbox__caption"></p>
        <p class="gallery-lightbox__meta"></p>
      </div>
      <div class="gallery-lightbox__exif" hidden>
        <p class="gallery-lightbox__details-label">Details</p>
      </div>
      <div class="gallery-lightbox__footer">
        <span class="gallery-lightbox__counter" aria-live="polite"></span>
      </div>
    </div>
  </aside>
</dialog>

<script src="../scripts/gallery-lightbox.ts"></script>
