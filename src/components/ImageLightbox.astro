<dialog class="microblog-lightbox" data-image-lightbox aria-label="Full-size image">
  <button class="microblog-lightbox__close" type="button" aria-label="Close full-size image"
    >×</button
  >
  <button
    class="microblog-lightbox__nav microblog-lightbox__nav--previous"
    type="button"
    aria-label="Previous image"
  >
    <span class="microblog-lightbox__nav-icon" aria-hidden="true">↓</span>
  </button>
  <div class="microblog-lightbox__stage">
    <img class="microblog-lightbox__image" alt="" decoding="async" draggable="false" />
    <div class="microblog-image-caption microblog-lightbox__caption" hidden></div>
  </div>
  <button
    class="microblog-lightbox__nav microblog-lightbox__nav--next"
    type="button"
    aria-label="Next image"
  >
    <span class="microblog-lightbox__nav-icon" aria-hidden="true">↓</span>
  </button>
  <div class="microblog-lightbox__counter" aria-live="polite"></div>
</dialog>

<div
  class="microblog-image-caption microblog-image-tooltip"
  data-image-caption-tooltip
  role="tooltip"
  hidden
>
</div>

<script src="../scripts/image-lightbox.ts"></script>
