---
interface Props {
  blogHref?: string;
  mainSiteNavigation?: boolean;
}

const year = new Date().getFullYear();
const { blogHref = '/blog', mainSiteNavigation = false } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">Tung’s</div>
    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/" data-main-site-link={mainSiteNavigation || undefined}>Home</a>
      <a href="/academic" data-cv-site-link>Research</a>
      <a href="/work" data-main-site-link={mainSiteNavigation || undefined}>Work</a>
      <a href={blogHref} data-main-site-link={mainSiteNavigation || undefined}>Blog</a>
      <a href="/microblog" data-main-site-link={mainSiteNavigation || undefined}>Microblog</a>
      <a href="/rss.xml" data-main-site-link={mainSiteNavigation || undefined}>RSS</a>
    </nav>
    <div class="site-footer__meta">© {year} Tung Wang.</div>
  </div>
</footer>
