---
interface Props {
  blogHref?: string;
  mainSiteNavigation?: boolean;
  activeSection?: 'research' | 'work' | 'gallery' | 'blog' | 'microblog';
}

const year = new Date().getFullYear();
const { blogHref = '/blog', mainSiteNavigation = false, activeSection } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">Tung’s</div>
    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/" data-main-site-link={mainSiteNavigation || undefined}>Home</a>
      {
        activeSection === 'research' ? (
          <span class="site-footer__current" aria-current="page">
            Research
          </span>
        ) : (
          <a href="/academic" data-cv-site-link>
            Research
          </a>
        )
      }
      {
        activeSection === 'work' ? (
          <span class="site-footer__current" aria-current="page">
            Work
          </span>
        ) : (
          <a href="/work" data-main-site-link={mainSiteNavigation || undefined}>
            Work
          </a>
        )
      }
      {
        activeSection === 'blog' ? (
          <span class="site-footer__current" aria-current="page">
            Blog
          </span>
        ) : (
          <a href={blogHref} data-main-site-link={mainSiteNavigation || undefined}>
            Blog
          </a>
        )
      }
      {
        activeSection === 'microblog' ? (
          <span class="site-footer__current" aria-current="page">
            Microblog
          </span>
        ) : (
          <a href="/microblog" data-main-site-link={mainSiteNavigation || undefined}>
            Microblog
          </a>
        )
      }
      {
        activeSection === 'gallery' ? (
          <span class="site-footer__current" aria-current="page">
            Gallery
          </span>
        ) : (
          <a href="/gallery" data-main-site-link={mainSiteNavigation || undefined}>
            Gallery
          </a>
        )
      }
      <a href="/rss.xml" data-main-site-link={mainSiteNavigation || undefined}>RSS</a>
    </nav>
    <div class="site-footer__meta">© {year} Tung Wang.</div>
  </div>
</footer>
