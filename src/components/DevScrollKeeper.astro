<script is:inline>
  (() => {
    const hashPattern = /^#dev-preview-(\d+)-([a-z0-9]+)$/;
    const storageKey = 'dev-preview-scroll:' + location.pathname + location.search;
    const requestedAnchor = location.hash.match(hashPattern);
    let saved = null;
    try {
      const value = JSON.parse(sessionStorage.getItem(storageKey) || 'null');
      if (
        value?.version === 2 &&
        Number.isFinite(value.top) &&
        Date.now() - value.time < 43200000
      ) {
        saved = value;
      }
    } catch {
      // Preview panes may disable storage. URL anchors remain a fallback.
    }
    // An explicit section link must win over an earlier editing position.
    if (location.hash && !requestedAnchor) saved = null;
    const shouldRestore = Boolean(requestedAnchor || saved);
    const previousRestoration = history.scrollRestoration;
    let guardStyle = null;
    const reveal = () => delete document.documentElement.dataset.devAnchorHidden;
    const clearGuard = () => {
      reveal();
      delete document.documentElement.dataset.devAnchorRestoring;
      guardStyle?.remove();
      history.scrollRestoration = previousRestoration;
    };

    if (shouldRestore) {
      history.scrollRestoration = 'manual';
      document.documentElement.dataset.devAnchorRestoring = '';
      document.documentElement.dataset.devAnchorHidden = '';
      guardStyle = document.createElement('style');
      guardStyle.textContent =
        'html[data-dev-anchor-restoring], html[data-dev-anchor-restoring] .blog-post-page { scroll-behavior: auto !important; }' +
        'html[data-dev-anchor-hidden] body { visibility: hidden !important; }';
      document.head.append(guardStyle);
      // Never leave a failed or interrupted development preview invisible.
      setTimeout(clearGuard, 3000);
    }

    const start = () => {
      const page = document.querySelector('.blog-post-page');
      const article = page?.querySelector('.prose');
      if (!article) {
        clearGuard();
        return;
      }
      const blocks = Array.from(article.children).filter(
        (element) =>
          element instanceof HTMLElement &&
          !['SCRIPT', 'STYLE', 'TEMPLATE'].includes(element.tagName),
      );
      const details = Array.from(article.querySelectorAll('details'));
      const usesPageScroll = () => /(auto|scroll)/.test(getComputedStyle(page).overflowY);
      const scrollTop = () => (usesPageScroll() ? page.scrollTop : window.scrollY);
      const scrollTo = (top) => {
        const options = { top: Math.max(0, top), behavior: 'auto' };
        if (usesPageScroll()) page.scrollTo(options);
        else window.scrollTo(options);
      };
      const topGuide = () => {
        const paper = document.querySelector('.blog-paper-viewport-bottom');
        return (paper?.getBoundingClientRect().top || 0) + 16;
      };
      const hashSignature = (value) => {
        let hash = 2166136261;
        for (let index = 0; index < value.length; index += 1) {
          hash ^= value.charCodeAt(index);
          hash = Math.imul(hash, 16777619);
        }
        return (hash >>> 0).toString(36);
      };
      const signature = (element) => {
        const summary = element.matches('details') ? element.querySelector('summary') : null;
        const text =
          (summary || element).textContent?.replace(/\s+/g, ' ').trim().slice(0, 160) || '';
        const images = Array.from(element.querySelectorAll('img'))
          .slice(0, 3)
          .map((image) => image.dataset.originalSrc || image.getAttribute('src') || '')
          .join('|');
        return hashSignature(element.tagName + ':' + (text || images));
      };
      blocks.forEach((block, index) => {
        block.dataset.devPreviewAnchor = 'dev-preview-' + index + '-' + signature(block);
      });
      const findTarget = (anchor) => {
        const match = anchor?.match(/^dev-preview-(\d+)-([a-z0-9]+)$/);
        if (!match) return null;
        const exact = blocks.find((block) => block.dataset.devPreviewAnchor === anchor);
        // Inserting paragraphs changes indices; editing text changes signatures.
        return (
          exact ||
          blocks.find((block) => block.dataset.devPreviewAnchor.endsWith('-' + match[2])) ||
          blocks[Number(match[1])] ||
          null
        );
      };

      let updateFrame = 0;
      let correctionFrame = 0;
      let restoring = shouldRestore;
      const detailStates = () =>
        details.map((detail, index) => ({
          index,
          signature: signature(detail),
          open: detail.open,
        }));
      const capture = () => {
        if (restoring) return;
        const guide = topGuide();
        const inArticle = article.getBoundingClientRect().top <= guide;
        const target = inArticle
          ? blocks.find((block) => block.getBoundingClientRect().bottom > guide) || blocks.at(-1)
          : null;
        const anchor = target?.dataset.devPreviewAnchor || null;
        const state = {
          version: 2,
          top: scrollTop(),
          anchor,
          offset: target ? target.getBoundingClientRect().top - guide : 0,
          details: detailStates(),
          time: Date.now(),
        };
        try {
          sessionStorage.setItem(storageKey, JSON.stringify(state));
        } catch {}
        const hash = anchor ? '#' + anchor : '';
        if (hash !== location.hash && (anchor || hashPattern.test(location.hash))) {
          try {
            history.replaceState(history.state, '', location.pathname + location.search + hash);
          } catch {}
        }
      };
      const scheduleCapture = () => {
        if (restoring || updateFrame) return;
        updateFrame = requestAnimationFrame(() => {
          updateFrame = 0;
          capture();
        });
      };
      // Narrow article pages scroll internally; desktop/tablet scroll the window.
      window.addEventListener('scroll', scheduleCapture, { passive: true });
      page.addEventListener('scroll', scheduleCapture, { passive: true });
      article.addEventListener('toggle', scheduleCapture, true);
      window.addEventListener('pagehide', capture);
      window.addEventListener('beforeunload', capture);

      if (!shouldRestore) {
        capture();
        return;
      }
      for (const state of saved?.details || []) {
        const detail = details[state.index];
        if (detail && signature(detail) === state.signature) detail.open = state.open;
      }
      const anchor = requestedAnchor ? location.hash.slice(1) : saved?.anchor;
      const target = findTarget(anchor);
      const offset = saved?.anchor === anchor && Number.isFinite(saved.offset) ? saved.offset : 0;
      const restore = () => {
        if (!restoring) return;
        if (target && document.contains(target)) {
          scrollTo(scrollTop() + target.getBoundingClientRect().top - topGuide() - offset);
        } else if (saved) {
          scrollTo(saved.top);
        }
      };
      const scheduleCorrection = () => {
        if (!restoring || correctionFrame) return;
        correctionFrame = requestAnimationFrame(() => {
          correctionFrame = 0;
          restore();
        });
      };
      const resizeObserver = new ResizeObserver(scheduleCorrection);
      const finish = () => {
        if (!restoring) return;
        restoring = false;
        resizeObserver.disconnect();
        if (correctionFrame) cancelAnimationFrame(correctionFrame);
        clearGuard();
        capture();
      };
      // Stop correcting immediately once the reader takes control.
      window.addEventListener('wheel', finish, { passive: true, once: true });
      window.addEventListener('touchstart', finish, { passive: true, once: true });
      window.addEventListener('pointerdown', finish, { passive: true, once: true });
      window.addEventListener('keydown', finish, { once: true });
      resizeObserver.observe(article);
      document.fonts?.ready.then(scheduleCorrection);
      article.querySelectorAll('img').forEach((image) => {
        if (!image.complete) {
          image.addEventListener('load', scheduleCorrection, { once: true });
          image.addEventListener('error', scheduleCorrection, { once: true });
        }
      });
      window.addEventListener('load', scheduleCorrection, { once: true });
      requestAnimationFrame(() => {
        restore();
        reveal();
      });
      [120, 500, 1000, 1800].forEach((delay) => setTimeout(restore, delay));
      setTimeout(finish, 2500);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>
