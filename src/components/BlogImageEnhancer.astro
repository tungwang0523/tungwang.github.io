<script>
  const images = Array.from(
    document.querySelectorAll<HTMLImageElement>('.blog-post-page .prose img'),
  );

  const prose = document.querySelector<HTMLElement>('.blog-post-page .prose');

  const imageMediaInBlock = (block: Element) => {
    if (block.tagName !== 'P') return null;

    const media: HTMLElement[] = [];
    for (const node of block.childNodes) {
      if (node.nodeType === Node.TEXT_NODE && !node.textContent?.trim()) continue;
      if (!(node instanceof HTMLElement)) return null;

      if (node instanceof HTMLImageElement) {
        media.push(node);
        continue;
      }

      if (
        node instanceof HTMLAnchorElement
        && node.textContent?.trim() === ''
        && node.children.length === 1
        && node.firstElementChild instanceof HTMLImageElement
      ) {
        media.push(node);
        continue;
      }

      return null;
    }

    return media.length > 0 ? media : null;
  };

  if (prose) {
    const blocks = Array.from(prose.children);
    for (let index = 0; index < blocks.length;) {
      const run: Array<{ block: Element; media: HTMLElement[] }> = [];
      let imageCount = 0;

      while (index < blocks.length) {
        const block = blocks[index];
        const media = block ? imageMediaInBlock(block) : null;
        if (!block || !media) break;
        run.push({ block, media });
        imageCount += media.length;
        index += 1;
      }

      if (imageCount >= 2) {
        const grid = document.createElement('div');
        grid.className = 'blog-image-grid';
        run[0]?.block.insertAdjacentElement('beforebegin', grid);

        run.forEach(({ block, media }) => {
          media.forEach((item) => {
            const gridItem = document.createElement('span');
            gridItem.className = 'blog-image-grid__item';
            const gridMedia = document.createElement('span');
            gridMedia.className = 'blog-image-grid__media';
            gridItem.append(gridMedia);
            gridMedia.append(item);
            const gridImage = item instanceof HTMLImageElement
              ? item
              : item.querySelector<HTMLImageElement>('img');
            if (gridImage?.srcset) {
              gridImage.sizes = '(max-width: 560px) calc((100vw - 50px) / 3), 157px';
            }
            grid.append(gridItem);
          });
          block.remove();
        });
      }

      if (run.length === 0) index += 1;
    }
  }

  images.forEach((image) => {
    const caption = image.getAttribute('title')?.trim() || image.alt.trim();
    image.dataset.blogImage = '';
    image.dataset.caption = caption;
    image.loading = 'lazy';
    image.decoding = 'async';
    image.tabIndex = 0;
    image.setAttribute('role', 'button');
    image.setAttribute('aria-label', caption ? `View image: ${caption}` : 'View full-size image');
    image.draggable = false;

    if (caption) {
      const visibleCaption = document.createElement('small');
      visibleCaption.className = 'blog-image-caption';
      visibleCaption.textContent = caption;
      image.classList.add('has-blog-caption');

      const gridItem = image.closest('.blog-image-grid__item');
      if (gridItem) {
        gridItem.append(visibleCaption);
      } else {
        const imageLink = image.parentElement?.tagName === 'A' ? image.parentElement : null;
        (imageLink ?? image).insertAdjacentElement('afterend', visibleCaption);
      }
    }

    // The persistent caption replaces the browser's delayed native title tooltip.
    if (image.hasAttribute('title')) image.removeAttribute('title');
  });

  if (images.length > 0) {
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dialog = document.createElement('dialog');
    dialog.className = 'microblog-lightbox blog-lightbox';
    dialog.setAttribute('aria-label', 'Full-size article image');
    dialog.innerHTML = `
      <button class="microblog-lightbox__close" type="button" aria-label="Close full-size image">×</button>
      <button class="microblog-lightbox__nav microblog-lightbox__nav--previous" type="button" aria-label="Previous image">
        <span class="microblog-lightbox__nav-icon" aria-hidden="true">↓</span>
      </button>
      <div class="microblog-lightbox__stage">
        <img class="microblog-lightbox__image" alt="" decoding="async" draggable="false" />
        <div class="microblog-image-caption microblog-lightbox__caption" hidden></div>
      </div>
      <button class="microblog-lightbox__nav microblog-lightbox__nav--next" type="button" aria-label="Next image">
        <span class="microblog-lightbox__nav-icon" aria-hidden="true">↓</span>
      </button>
      <div class="microblog-lightbox__counter" aria-live="polite"></div>
    `;
    document.body.append(dialog);

    const lightboxImage = dialog.querySelector<HTMLImageElement>('.microblog-lightbox__image');
    const lightboxStage = dialog.querySelector<HTMLElement>('.microblog-lightbox__stage');
    const lightboxCaption = dialog.querySelector<HTMLElement>('.microblog-lightbox__caption');
    const previousButton = dialog.querySelector<HTMLButtonElement>('.microblog-lightbox__nav--previous');
    const nextButton = dialog.querySelector<HTMLButtonElement>('.microblog-lightbox__nav--next');
    const counter = dialog.querySelector<HTMLElement>('.microblog-lightbox__counter');
    let activeIndex = 0;
    let lastTrigger: HTMLImageElement | null = null;
    let imageIsSwitching = false;
    let imageRequestId = 0;
    const imagePreloads = new Map<string, Promise<boolean>>();

    const preloadImage = (source: string) => {
      const existing = imagePreloads.get(source);
      if (existing) return existing;

      const request = new Promise<boolean>((resolve) => {
        const loader = new Image();
        loader.onload = () => resolve(true);
        loader.onerror = () => resolve(false);
        loader.src = source;
      });
      imagePreloads.set(source, request);
      return request;
    };

    const fullImageSource = (source: HTMLImageElement) =>
      (window.matchMedia('(max-width: 768px)').matches
        ? source.dataset.lightboxMobileSrc
        : source.dataset.lightboxSrc)
      || source.dataset.lightboxSrc
      || source.dataset.originalSrc
      || source.currentSrc
      || source.src;

    const preloadNeighbors = (index: number) => {
      [images[index - 1], images[index + 1]].forEach((neighbor) => {
        if (neighbor) void preloadImage(fullImageSource(neighbor));
      });
    };

    const showDialog = () => {
      dialog.classList.remove('is-closing');
      dialog.showModal();
      if (reducedMotion()) {
        dialog.classList.add('is-visible');
        return;
      }
      requestAnimationFrame(() => requestAnimationFrame(() => dialog.classList.add('is-visible')));
    };

    const hideDialog = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      imageRequestId += 1;
      if (reducedMotion()) {
        dialog.close();
        return;
      }
      dialog.classList.add('is-closing');
      dialog.classList.remove('is-visible');
      window.setTimeout(() => {
        if (dialog.open) dialog.close();
      }, 220);
    };

    const renderCaption = (container: HTMLElement, caption: string) => {
      container.replaceChildren();
      if (!caption) {
        container.hidden = true;
        return;
      }

      const item = document.createElement('span');
      item.className = 'microblog-image-caption__item';
      item.textContent = caption;
      container.append(item);
      container.hidden = false;
    };

    const renderImage = (index: number, displaySource?: string) => {
      const source = images[index];
      if (!source || !lightboxImage || !lightboxCaption || !previousButton || !nextButton || !counter) return;

      activeIndex = index;
      lightboxImage.src = displaySource || fullImageSource(source);
      lightboxImage.alt = source.alt;
      renderCaption(lightboxCaption, source.dataset.caption ?? '');

      const hasMultipleImages = images.length > 1;
      previousButton.hidden = !hasMultipleImages;
      nextButton.hidden = !hasMultipleImages;
      counter.hidden = !hasMultipleImages;
      previousButton.disabled = index === 0;
      nextButton.disabled = index === images.length - 1;
      counter.textContent = `${index + 1} / ${images.length}`;
      dialog.setAttribute('aria-label', `Full-size article image ${index + 1} of ${images.length}`);
    };

    const move = async (direction: -1 | 1) => {
      const nextIndex = activeIndex + direction;
      if (nextIndex < 0 || nextIndex >= images.length || imageIsSwitching) return;
      if (!lightboxImage) return;

      imageIsSwitching = true;
      const requestId = ++imageRequestId;
      const nextSource = images[nextIndex];
      if (!nextSource || !lightboxStage) {
        imageIsSwitching = false;
        return;
      }
      const nextImageUrl = fullImageSource(nextSource);
      const loading = preloadImage(nextImageUrl);
      const distance = direction > 0 ? -28 : 28;
      const outgoing = !reducedMotion() && !lightboxImage.classList.contains('is-loading')
        ? lightboxImage.animate(
            [
              { opacity: 1, transform: 'translateX(0)' },
              { opacity: 0, transform: `translateX(${distance}px)` },
            ],
            { duration: 120, easing: 'ease-in', fill: 'forwards' },
          )
        : null;
      await outgoing?.finished.catch(() => undefined);
      if (requestId !== imageRequestId || !dialog.open) {
        outgoing?.cancel();
        imageIsSwitching = false;
        return;
      }
      lightboxImage.classList.add('is-loading');
      lightboxStage.classList.add('is-loading');
      renderImage(nextIndex, nextImageUrl);
      outgoing?.cancel();
      imageIsSwitching = false;

      const loaded = await loading;
      if (requestId !== imageRequestId || !dialog.open) return;
      if (!loaded) {
        lightboxImage.classList.remove('is-loading');
        lightboxStage.classList.remove('is-loading');
        return;
      }
      await lightboxImage.decode().catch(() => undefined);
      lightboxImage.classList.remove('is-loading');
      lightboxStage.classList.remove('is-loading');
      preloadNeighbors(nextIndex);
      if (reducedMotion()) return;
      const incoming = lightboxImage.animate(
        [
          { opacity: 0, transform: `translateX(${-distance}px)` },
          { opacity: 1, transform: 'translateX(0)' },
        ],
        { duration: 190, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
      );
      await incoming.finished.catch(() => undefined);
    };

    const open = (image: HTMLImageElement) => {
      lastTrigger = image;
      const index = images.indexOf(image);
      const requestId = ++imageRequestId;
      const fullSource = fullImageSource(image);
      renderImage(index, image.currentSrc || image.src);
      showDialog();
      void preloadImage(fullSource).then((loaded) => {
        if (!loaded || requestId !== imageRequestId || activeIndex !== index || !dialog.open || !lightboxImage) return;
        lightboxImage.src = fullSource;
        preloadNeighbors(index);
      });
    };

    images.forEach((image) => {
      image.addEventListener('click', (event) => {
        event.preventDefault();
        open(image);
      });

      image.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        open(image);
      });

    });

    dialog.querySelector('.microblog-lightbox__close')?.addEventListener('click', hideDialog);
    previousButton?.addEventListener('click', () => move(-1));
    nextButton?.addEventListener('click', () => move(1));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) hideDialog();
    });
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      hideDialog();
    });
    dialog.addEventListener('close', () => {
      dialog.classList.remove('is-visible', 'is-closing');
      lightboxImage?.classList.remove('is-loading');
      lightboxStage?.classList.remove('is-loading');
      imageIsSwitching = false;
      lastTrigger?.focus();
    });

    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        move(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        move(1);
      }
    });

    let touchStartX: number | null = null;
    let touchStartY: number | null = null;

    lightboxImage?.addEventListener('touchstart', (event) => {
      const touch = event.changedTouches[0];
      if (!touch) return;
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
    }, { passive: true });

    lightboxImage?.addEventListener('touchend', (event) => {
      const touch = event.changedTouches[0];
      if (!touch || touchStartX === null || touchStartY === null) return;

      const distanceX = touch.clientX - touchStartX;
      const distanceY = touch.clientY - touchStartY;
      touchStartX = null;
      touchStartY = null;
      if (Math.abs(distanceX) < 48 || Math.abs(distanceX) <= Math.abs(distanceY)) return;
      move(distanceX < 0 ? 1 : -1);
    }, { passive: true });
  }
</script>
