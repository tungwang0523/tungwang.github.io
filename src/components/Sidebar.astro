---
import Marquee from './Marquee.astro';
import MicroblogEntry from './MicroblogEntry.astro';
import MicroblogLanguageToggle from './MicroblogLanguageToggle.astro';
import Circle from './Circle.astro';

interface Entry {
  id: string;
  data: {
    date: Date;
    type: 'note' | 'image' | 'quote' | 'link';
    image?: string;
    alt?: string;
    images?: Array<{ src: string; alt: string }>;
    translation: string;
    imageTextEn?: Array<{ page: number; text: string[] }>;
    imageTextZh?: Array<{ page: number; text: string[] }>;
    comment?: string;
    commentEn?: string;
    location?: string;
    locationEn?: string;
    tags: string[];
    link?: string;
    linkLabel?: string;
    linkLabelEn?: string;
  };
  Content: any;
}

interface Props {
  entries: Entry[];
  heading?: string;
  archiveEntryId?: string;
}

const { entries, heading = 'Microblog', archiveEntryId } = Astro.props;
---

<aside class="blog-part right-blog microblog-sidebar" aria-label="Latest microblog entries" data-microblog-scope data-language="zh">
  <div class="microblog-sidebar__sticky-head">
    <Marquee
      items={[
        'I’m applying for PhD programmes. If you’re looking for a doctoral student, I’d love to hear from you.',
        'Not a PhD supervisor? I’m also looking for a girlfriend. If you’d like to date me, I’d love to hear from you too.',
      ]}
    />
    <div class="blog-right-title-container">
      <div class="blog-right-title">{heading}</div>
      <MicroblogLanguageToggle />
    </div>
  </div>
  <div class="blog-right microblog-feed">
    {
      entries.map((entry) => <MicroblogEntry entry={entry} Content={entry.Content} compact />)
    }
    {archiveEntryId && (
      <Circle
        href={`/microblog#${archiveEntryId}`}
        title="Earlier Notes"
        titleEn="Earlier Notes"
        subtitle=""
        subtitleEn=""
        cta="View All"
        ctaEn="View All"
        showArrow
      />
    )}
  </div>
</aside>
