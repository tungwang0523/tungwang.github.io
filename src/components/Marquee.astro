---
interface Props {
  items?: string[];
}

const {
  items = [
    'Now And Then You Miss It Sounds Make You Cry',
    'Now In - MoMa Sharing Exhibition NOW',
    'NYC Opens After Long Lockdown Check',
  ],
} = Astro.props;
---

<div class="site-marquee" aria-label={items.join('. ')}>
  <div class="site-marquee__track">
    <div class="site-marquee__group">
      {items.map((text) => <span>{text}</span>)}
    </div>
    <div class="site-marquee__group" aria-hidden="true">
      {items.map((text) => <span>{text}</span>)}
    </div>
  </div>
</div>
