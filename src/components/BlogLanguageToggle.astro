---
interface Props {
  current?: 'zh' | 'en';
  zhHref?: string;
  enHref?: string;
}

const { current = 'zh', zhHref, enHref } = Astro.props;
const linked = Boolean(zhHref || enHref);
---

<div class="blog-language" role="group" aria-label="Blog language">
  {
    linked ? (
      <>
        {zhHref ? (
          <a
            class="blog-language__zh"
            href={zhHref}
            aria-current={current === 'zh' ? 'page' : undefined}
          >
            中文
          </a>
        ) : (
          <span class="blog-language__zh" aria-disabled="true">
            中文
          </span>
        )}
        <i aria-hidden="true">/</i>
        {enHref ? (
          <a href={enHref} aria-current={current === 'en' ? 'page' : undefined}>
            EN
          </a>
        ) : (
          <span aria-disabled="true">EN</span>
        )}
      </>
    ) : (
      <>
        <button
          class="blog-language__zh"
          type="button"
          data-blog-language-option="zh"
          aria-pressed="true"
        >
          中文
        </button>
        <i aria-hidden="true">/</i>
        <button type="button" data-blog-language-option="en" aria-pressed="false">
          EN
        </button>
      </>
    )
  }
</div>

<script src="../scripts/blog-language-toggle.ts"></script>
