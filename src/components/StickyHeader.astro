---
interface Props {
  title: string;
  pinnedLabel?: string;
  pageNumber?: string;
  pageContext?: string[];
}

const {
  title,
  pinnedLabel = 'Pinned Issue',
  pageNumber = 'NO. 01',
  pageContext = [],
} = Astro.props;
---

<div class="blog-header blog-is-sticky">
  <div class="blog-article header-article">
    <div class="blog-big__title">{title}</div>
    {pinnedLabel && <div class="blog-menu rounded small-title">{pinnedLabel}</div>}
  </div>
  <div class="blog-article page-number">
    {
      pageContext.length > 0 && (
        <div class="page-number__context">
          {pageContext.map((line) => <span>{line}</span>)}
        </div>
      )
    }
    {pageNumber && <strong>{pageNumber}</strong>}
  </div>
</div>
