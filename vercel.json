{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "cv.tung.mockingbird.team"
        }
      ],
      "dest": "/academic/index.html"
    },
    { "handle": "filesystem" },
    {
      "src": "^/stats/(.*)$",
      "dest": "https://cloud.umami.is/$1"
    }
  ]
}
